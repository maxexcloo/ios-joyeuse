diff --git a/phone/metal2/NativeBridgeMetalFrontend.mm b/phone/metal2/NativeBridgeMetalFrontend.mm
--- a/phone/metal2/NativeBridgeMetalFrontend.mm
+++ b/phone/metal2/NativeBridgeMetalFrontend.mm
@@ -1444,3 +1444,9 @@
 - (id<MTLTexture>)newTextureWithDescriptor:(MTLTextureDescriptor *)d iosurface:(IOSurfaceRef)surface plane:(NSUInteger)plane {
  if(!surface || !d || plane || IOSurfaceGetPlaneCount(surface))return nil;
+ // Normalize LA08 at the shared IOSurface import boundary before creating
+ // the backing texture. Do not depend on caller usage or descriptor format.
+ if(IOSurfaceGetPixelFormat(surface)==(((OSType)'L'<<24)|((OSType)'A'<<16)|((OSType)'0'<<8)|(OSType)'8')) {
+  d.swizzle=MTLTextureSwizzleChannelsMake(MTLTextureSwizzleRed,MTLTextureSwizzleRed,
+    MTLTextureSwizzleRed,MTLTextureSwizzleGreen);
+ }
  noteSurfaceTexture(d,surface);
