+/* fts_reset_proc: active-low pulse, then optional high wait in ms. */
+static void
+fts_reset(unsigned hdelay_ms)
+{
+	touch_gpio_mi(8, 0, 3, 3, true, false);
+	touch_wait(1);
+	touch_gpio_mi(8, 0, 3, 3, true, true);
+	if (hdelay_ms) {
+		touch_wait(hdelay_ms);
+	}
+}
+
+static int
+fts_check_bootid(void)
+{
+	uint8_t id[2] = {0, 0};
+	uint8_t cmd[4] = {FTS_CMD_READ_ID, 0, 0, 0};
+	int err = fts_read(cmd, 4, id, 2);
+	if (!err && id[0] == 0x87 && id[1] == 0x56) {
+		return 0;
+	}
+	if (!err) {
+		err = EIO;
+	}
+	return err;
+}
+
+/* fts_get_ic_information: reset, 0x55 0xAA, boot id must be 8756 or F7A6. */
+static int
+fts_identify(void)
+{
+	for (unsigned cnt = 0; cnt < 3; ++cnt) {
+		fts_reset(0);
+		touch_wait(FTS_CMD_START_DELAY);
+		uint8_t start[2] = {FTS_CMD_START1, FTS_CMD_START2};
+		int err = fts_write2(start[0], start + 1, 1);
+		if (!err) {
+			touch_wait(FTS_CMD_START_DELAY);
+			uint8_t id[2] = {0, 0};
+			uint8_t cmd[4] = {FTS_CMD_READ_ID, 0, 0, 0};
+			err = fts_read(cmd, 4, id, 2);
+			if (!err && id[0] && id[1] &&
+			    ((id[0] == 0x87 && id[1] == 0x56) ||
+			     (id[0] == 0xf7 && id[1] == 0xa6))) {
+				return 0;
+			}
+			if (!err) {
+				err = EIO;
+			}
+		}
+		printf("SWEET TOUCH: fts identify try=%u err=%d\n", cnt, err);
+	}
+	return EIO;
+}
+
+/* fts_enter_into_boot: vendor loop — reset, START1, delay, check boot id. */
+static int
+fts_enter_boot(void)
+{
+	uint8_t start1 = FTS_CMD_START1;
+	for (unsigned i = 0; i < FTS_UPGRADE_LOOP; ++i) {
+		fts_reset(0);
+		touch_wait(8);
+		for (unsigned j = 0; j < FTS_READ_BOOTID_TRY; ++j) {
+			int err = fts_write2(start1, NULL, 0);
+			if (!err) {
+				touch_wait(8);
+				err = fts_check_bootid();
+				if (!err) {
+					printf("SWEET TOUCH: fts boot env at reset=%u try=%u\n", i, j);
+					return 0;
+				}
+			}
+		}
+	}
+	printf("SWEET TOUCH: fts enter boot environment failed\n");
+	return EIO;
+}
+
+/* fts_dpram_write: SET_PRAM_ADDR + WRITE per 32752-byte packet (spi_pe=0). */
+static int
+fts_dpram_write(uint32_t saddr, const uint8_t *buf, uint32_t len, bool wpram)
+{
+	uint32_t base = wpram ? FTS_PRAM_SADDR : FTS_DRAM_SADDR;
+	uint32_t packets = (len + FTS_PACKET - 1u) / FTS_PACKET;
+	printf("SWEET TOUCH: fts dpram %s len=%u packets=%u base=%#x\n",
+	    wpram ? "pram" : "dram", len, packets, base);
+	for (uint32_t off = 0; off < len; ) {
+		uint32_t addr = saddr + off + base;
+		uint32_t plen = len - off;
+		if (plen > FTS_PACKET) {
+			plen = FTS_PACKET;
+		}
+		uint8_t a[3] = {(uint8_t)(addr >> 16), (uint8_t)(addr >> 8), (uint8_t)addr};
+		int err = fts_write2(FTS_SET_PRAM_ADDR, a, 3);
+		if (err) {
+			printf("SWEET TOUCH: fts set addr %#x err=%d\n", addr, err);
+			return err;
+		}
+		err = fts_write2(FTS_WRITE_PRAM, buf + off, plen);
+		if (err) {
+			printf("SWEET TOUCH: fts pram write off=%u err=%d\n", off, err);
+			return err;
+		}
+		off += plen;
+	}
+	return 0;
+}
+
+/* Chunks of 32766: TP ECC (0xCC/0xCE poll, 0xCD read) vs host AL2 ECC. */
+static int
+fts_ecc_check(const uint8_t *buf, uint32_t len, uint32_t saddr)
+{
+	for (uint32_t off = 0; off < len; ) {
+		uint32_t chunk = len - off;
+		if (chunk > FTS_ECCHUNK) {
+			chunk = FTS_ECCHUNK;
+		}
+		uint32_t addr = saddr + off;
+		uint8_t c[6] = {(uint8_t)(addr >> 16), (uint8_t)(addr >> 8), (uint8_t)addr,
+		    (uint8_t)(chunk >> 16), (uint8_t)(chunk >> 8), (uint8_t)chunk};
+		int err = fts_write2(FTS_ECC, c, 6);
+		if (err) {
+			printf("SWEET TOUCH: fts ecc cmd err=%d\n", err);
+			return err;
+		}
+		touch_wait(2);
+		uint8_t fin = 0;
+		uint8_t fcmd = FTS_ECC_FINISH;
+		for (unsigned i = 0; i < FTS_ECC_FINISH_TRY; ++i) {
+			err = fts_read(&fcmd, 1, &fin, 1);
+			if (err) {
+				return err;
+			}
+			if (fin == FTS_ECC_OK) {
+				break;
+			}
+			touch_wait(1);
+		}
+		if (fin != FTS_ECC_OK) {
+			printf("SWEET TOUCH: fts ecc finish timeout val=%#x\n", fin);
+			return EIO;
+		}
+		uint8_t v[2] = {0, 0};
+		uint8_t rcmd = FTS_ECC_READ;
+		err = fts_read(&rcmd, 1, v, 2);
+		if (err) {
+			return err;
+		}
+		uint16_t tp = (uint16_t)((v[0] << 8) | v[1]);
+		uint16_t host = fts_ecc_host(buf + off, chunk);
+		if (tp != host) {
+			printf("SWEET TOUCH: fts ecc mismatch addr=%#x len=%u tp=%04x host=%04x\n",
+			    addr, chunk, tp, host);
+			return EIO;
+		}
+		printf("SWEET TOUCH: fts ecc ok addr=%#x len=%u tp=%04x\n", addr, chunk, tp);
+		off += chunk;
+	}
+	return 0;
+}
+
+/* Header at 0x100: code_len/code_len_n (complement), half_length=1 => *2. */
+static int
+fts_pram_write_ecc(const uint8_t *buf, uint32_t len)
+{
+	(void)len;
+	uint32_t code_len = ((uint32_t)buf[FTS_APP_INFO_OFFSET] << 8) |
+	    buf[FTS_APP_INFO_OFFSET + 1];
+	uint32_t code_len_n = ((uint32_t)buf[FTS_APP_INFO_OFFSET + 2] << 8) |
+	    buf[FTS_APP_INFO_OFFSET + 3];
+	if (code_len + code_len_n != 0xffffu || !code_len) {
+		printf("SWEET TOUCH: fts pram code len %#x/%#x invalid\n", code_len, code_len_n);
+		return EINVAL;
+	}
+	uint32_t size = code_len * 2u;
+	int err = fts_dpram_write(FTS_PRAM_SADDR, buf, size, true);
+	if (err) {
+		return err;
+	}
+	return fts_ecc_check(buf, size, FTS_PRAM_SADDR);
+}
+
+static int
+fts_dram_write_ecc(const uint8_t *buf, uint32_t len)
+{
+	(void)len;
+	uint32_t const_len = ((uint32_t)buf[FTS_APP_INFO_OFFSET + 8] << 8) |
+	    buf[FTS_APP_INFO_OFFSET + 9];
+	uint32_t const_len_n = ((uint32_t)buf[FTS_APP_INFO_OFFSET + 10] << 8) |
+	    buf[FTS_APP_INFO_OFFSET + 11];
+	if (const_len + const_len_n != 0xffffu || !const_len) {
+		printf("SWEET TOUCH: fts no dram section (%#x/%#x)\n", const_len, const_len_n);
+		return 0;
+	}
+	uint32_t pram = (((uint32_t)buf[FTS_APP_INFO_OFFSET] << 8) |
+	    buf[FTS_APP_INFO_OFFSET + 1]) * 2u;
+	uint32_t size = const_len * 2u;
+	if (pram + size > len) {
+		printf("SWEET TOUCH: fts dram out of range off=%u len=%u bin=%u\n", pram, size, len);
+		return EINVAL;
+	}
+	int err = fts_dpram_write(FTS_PRAM_SADDR, buf + pram, size, false);
+	if (err) {
+		return err;
+	}
+	/* Vendor checks DRAM ECC with saddr 0; Android passed with it — keep. */
+	return fts_ecc_check(buf + pram, size, FTS_PRAM_SADDR);
+}
+
+static int
+fts_fw_write_start(const uint8_t *buf, uint32_t len)
+{
+	int err = fts_enter_boot();
+	if (err) {
+		return err;
+	}
+	err = fts_pram_write_ecc(buf, len);
+	if (err) {
+		return err;
+	}
+	err = fts_dram_write_ecc(buf, len);
+	if (err) {
+		return err;
+	}
+	uint8_t cmd = FTS_START_APP;
+	return fts_write2(cmd, NULL, 0);
+}
+
+/* fts_fw_download: three attempts, each: boot env, pram, dram, remap+run. */
+static int
+fts_fw_download(const uint8_t *buf, uint32_t len)
+{
+	if (len < 0x120u) {
+		return EINVAL;
+	}
+	for (unsigned i = 0; i < 3; ++i) {
+		printf("SWEET TOUCH: fts fw download %u/3 (%u bytes)\n", i + 1, len);
+		int err = fts_fw_write_start(buf, len);
+		if (!err) {
+			touch_wait(50);
+			return 0;
+		}
+		printf("SWEET TOUCH: fts fw download %u failed err=%d\n", i + 1, err);
+	}
+	return EIO;
+}
+
+static int
+fts_write_reg(uint8_t addr, uint8_t val)
+{
+	return fts_write2(addr, &val, 1);
+}
+
+static int
+fts_read_reg(uint8_t addr, uint8_t *val)
+{
+	return fts_read(&addr, 1, val, 1);
+}
