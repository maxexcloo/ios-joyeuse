+/* ---- FocalTech FT8756 over bit-banged SPI (miatoll qup15 gpio53-56) ----
+ * DT: spi@a94000 (qcom,spi-geni, SE11) qupv3_se11_spi_active pins 53-56
+ * function qup15 — all four are in the WEST TLMM tile (pinctrl-atoll.c
+ * WEST=0x100000). CLK/MOSI/MISO/CS order within the group is not documented,
+ * so every ordering is tried until the boot id answers 87 56; the identify
+ * check makes the winner unambiguous. Never touches the GENI core itself. */
+static const uint8_t fts_maps[][4] = { /* clk, mosi, miso, cs */
+	{53, 54, 55, 56}, {53, 55, 54, 56}, {53, 54, 56, 55}, {53, 56, 54, 55},
+	{54, 53, 55, 56}, {54, 55, 53, 56}, {54, 53, 56, 55}, {54, 56, 53, 55},
+	{54, 55, 56, 53}, {54, 56, 55, 53}, {53, 56, 55, 54}, {53, 55, 56, 54},
+	{55, 53, 54, 56}, {55, 54, 53, 56}, {55, 53, 56, 54}, {55, 56, 53, 54},
+	{55, 54, 56, 53}, {55, 56, 54, 53}, {56, 53, 54, 55}, {56, 54, 53, 55},
+	{56, 53, 55, 54}, {56, 55, 53, 54}, {56, 54, 55, 53}, {56, 55, 54, 53},
+};
+#define FTS_MAP_COUNT (sizeof(fts_maps) / sizeof(fts_maps[0]))
+
+static uint8_t fts_txbuf[FTS_PACKET + 64];
+static uint8_t fts_rxbuf[FTS_PACKET + 64];
+
+static void
+fts_io(unsigned pin, bool high)
+{
+	vm_offset_t gpio = touch_pad(pin);
+	uint32_t io = touch_rd(gpio, TOUCH_GPIO_IO(pin));
+	touch_wr(gpio, TOUCH_GPIO_IO(pin), high ? (io | 2u) : (io & ~2u));
+}
+
+static bool
+fts_in(unsigned pin)
+{
+	return (touch_rd(touch_pad(pin), TOUCH_GPIO_IO(pin)) & 1u) != 0;
+}
+
+static void
+fts_spi_cfg(void)
+{
+	/* SPI mode 0: CLK idles low, CS idles high, 8 mA edges (DT: 6 mA). */
+	touch_gpio_mi(st.sp_clk, 0, 0, 3, true, false);
+	touch_gpio_mi(st.sp_mosi, 0, 0, 3, true, false);
+	touch_gpio_mi(st.sp_cs, 0, 0, 3, true, true);
+	touch_gpio_mi(st.sp_miso, 0, 3, 3, false, false);
+}
+
+/* MSB first, sample on the rising edge; rx may be NULL for write-only. */
+static void
+fts_xfer(const uint8_t *tx, uint8_t *rx, unsigned len)
+{
+	fts_io(st.sp_cs, false);
+	for (unsigned i = 0; i < len; ++i) {
+		uint8_t in = 0;
+		for (int b = 7; b >= 0; --b) {
+			fts_io(st.sp_mosi, (tx[i] >> b) & 1u);
+			delay(FTS_SPI_HALF);
+			fts_io(st.sp_clk, true);
+			delay(FTS_SPI_HALF);
+			if (fts_in(st.sp_miso)) {
+				in |= (uint8_t)(1u << b);
+			}
+			fts_io(st.sp_clk, false);
+		}
+		if (rx) {
+			rx[i] = in;
+		}
+	}
+	fts_io(st.sp_cs, true);
+	delay(FTS_CS_DELAY);
+}
+
+/* Reflected CRC16 (crckermit): init 0xffff, poly 0x8408, byte-wise. */
+static uint16_t
+fts_crc16(const uint8_t *data, unsigned len)
+{
+	uint16_t crc = 0xffffu;
+	for (unsigned i = 0; i < len; ++i) {
+		crc ^= data[i];
+		for (unsigned j = 0; j < 8; ++j) {
+			crc = (crc & 1u) ? (uint16_t)((crc >> 1) ^ 0x8408u)
+			                : (uint16_t)(crc >> 1);
+		}
+	}
+	return crc;
+}
+
+/* Host-side ECC over big-endian 16-bit words (fts_ecc_cal_host/AL2). */
+static uint16_t
+fts_ecc_host(const uint8_t *data, unsigned len)
+{
+	uint16_t ecc = 0;
+	for (unsigned i = 0; i + 1 < len; i += 2) {
+		ecc ^= (uint16_t)((data[i] << 8) | data[i + 1]);
+		for (unsigned j = 0; j < 16; ++j) {
+			ecc = (ecc & 1u) ? (uint16_t)((ecc >> 1) ^ 0x8408u)
+			                : (uint16_t)(ecc >> 1);
+		}
+	}
+	return ecc;
+}
+
+/* Frame [reg, 0x00, lenhi, lenlo, 3 dummy, dlen data]; status rx[3] & 0xA0 == 0. */
+static int
+fts_write2(uint8_t reg, const uint8_t *data, unsigned dlen)
+{
+	if (dlen > FTS_PACKET || (dlen && !data)) {
+		return EIO;
+	}
+	fts_txbuf[0] = reg;
+	fts_txbuf[1] = FTS_WRITE_CMD;
+	fts_txbuf[2] = (uint8_t)(dlen >> 8);
+	fts_txbuf[3] = (uint8_t)dlen;
+	unsigned len = 4;
+	if (dlen) {
+		memset(fts_txbuf + 4, 0, FTS_SPI_DUMMY);
+		memcpy(fts_txbuf + 4 + FTS_SPI_DUMMY, data, dlen);
+		len += FTS_SPI_DUMMY + dlen;
+	}
+	for (unsigned i = 0; i < FTS_SPI_RETRY; ++i) {
+		fts_xfer(fts_txbuf, fts_rxbuf, len);
+		if ((fts_rxbuf[3] & 0xa0u) == 0) {
+			return 0;
+		}
+		if (i + 1u == FTS_SPI_RETRY) {
+			printf("SWEET TOUCH: fts wr %#x status=%#x\n", reg, fts_rxbuf[3]);
+		}
+	}
+	return EIO;
+}
+
+/* Frame [reg, 0xa0, dlenhi, dlenlo, 3 dummy, dlen data, 2 CRC LE]; data at rx[7]. */
+static int
+fts_read(const uint8_t *cmd, unsigned cmdlen, uint8_t *data, unsigned dlen)
+{
+	if (!cmd || !cmdlen || !data || !dlen || dlen + 8u > FTS_PACKET + 64u) {
+		return EIO;
+	}
+	fts_txbuf[0] = cmd[0];
+	fts_txbuf[1] = FTS_READ_CMD;
+	fts_txbuf[2] = (uint8_t)(dlen >> 8);
+	fts_txbuf[3] = (uint8_t)dlen;
+	memset(fts_txbuf + 4, 0, FTS_SPI_DUMMY + dlen + 2u);
+	unsigned len = 4u + FTS_SPI_DUMMY + dlen + 2u;
+	for (unsigned i = 0; i < FTS_SPI_RETRY; ++i) {
+		fts_xfer(fts_txbuf, fts_rxbuf, len);
+		if ((fts_rxbuf[3] & 0xa0u) == 0) {
+			uint16_t crc = fts_crc16(fts_rxbuf + 7, dlen);
+			if (fts_rxbuf[7 + dlen] == (uint8_t)crc &&
+			    fts_rxbuf[8 + dlen] == (uint8_t)(crc >> 8)) {
+				memcpy(data, fts_rxbuf + 7, dlen);
+				return 0;
+			}
+			if (i + 1u == FTS_SPI_RETRY) {
+				printf("SWEET TOUCH: fts rd %#x crc bad (want %02x%02x got %02x%02x)\n",
+				    cmd[0], (uint8_t)crc, (uint8_t)(crc >> 8),
+				    fts_rxbuf[7 + dlen], fts_rxbuf[8 + dlen]);
+			}
+		} else if (i + 1u == FTS_SPI_RETRY) {
+			printf("SWEET TOUCH: fts rd %#x status=%#x\n", cmd[0], fts_rxbuf[3]);
+		}
+	}
+	return EIO;
+}
