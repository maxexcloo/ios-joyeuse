diff --git a/bsd/dev/sweet_adreno.c b/bsd/dev/sweet_adreno.c
new file mode 100644
index 0000000..58a1e02
--- /dev/null
+++ b/bsd/dev/sweet_adreno.c
@@ -0,0 +1,199 @@
+/* SPDX-License-Identifier: MIT
+ * Copyright (c) 2026 ios-sweet contributors
+ *
+ * Original portable implementation of the public A6xx PM4 wire format and
+ * SDM7150 CX GDSC sequence. References and limitations: docs/adreno-port.md.
+ * No Linux DRM or Mesa rendering implementation is included in this file.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(KERNEL)
+#include <sys/errno.h>
+#else
+#include <errno.h>
+#endif
+#include "sweet_adreno.h"
+
+#define CX_GDSCR 0x106cu
+#define CX_STATUS 0x1540u
+#define COLLAPSE 1u
+#define HW_CONTROL 2u
+#define POWER_ON 0x80000000u
+
+int
+a618_enable_cx(const struct a618_io *io, struct a618_power_result *result)
+{
+	uint32_t control, status;
+	if (!io || !result || !io->read || !io->write || !io->delay_us)
+		return EINVAL;
+	result->waited_us = 0;
+	control = result->control = io->read(io->cookie, CX_GDSCR);
+	status = result->status = io->read(io->cookie, CX_STATUS);
+	if (control == 0xffffffffu || status == 0xffffffffu)
+		return EIO;
+	if (control & HW_CONTROL)
+		return EBUSY;
+	/* This call does not reset an already powered domain. */
+	if (!(control & COLLAPSE) && (status & POWER_ON))
+		return 0;
+	/* Live DT: qcom,clk-dis-wait-val = 8; preserve all other fields. */
+	control = (control & ~(0xfu << 12)) | (8u << 12);
+	io->write(io->cookie, CX_GDSCR, control & ~COLLAPSE);
+	/* Qualcomm gdsc_enable: allow at least eight XO cycles before polling. */
+	io->delay_us(io->cookie, 1);
+	for (unsigned elapsed = 0; elapsed < 500; ++elapsed) {
+		result->waited_us = elapsed + 1;
+		status = result->status = io->read(io->cookie, CX_STATUS);
+		if (status == 0xffffffffu)
+			return EIO;
+		if (status & POWER_ON) {
+			/* Clock re-enable/memory power-up settling from gdsc_enable. */
+			io->delay_us(io->cookie, 2);
+			result->control = io->read(io->cookie, CX_GDSCR);
+			if (result->control == 0xffffffffu ||
+			    (result->control & (COLLAPSE | HW_CONTROL)))
+				return EIO;
+			return 0;
+		}
+		io->delay_us(io->cookie, 1);
+	}
+	result->control = io->read(io->cookie, CX_GDSCR);
+	/* Do not attempt a power-down after uncertain hardware completion. */
+	return ETIMEDOUT;
+}
+
+/* A6xx uses odd parity for the payload length and opcode/register fields. */
+static uint32_t
+odd_parity(uint32_t value)
+{
+	unsigned parity = 1;
+	while (value) {
+		parity ^= value & 1u;
+		value >>= 1;
+	}
+	return parity;
+}
+
+static int
+reserve(const struct a618_commands *commands, unsigned count)
+{
+	if (!commands || !commands->words || commands->used > commands->capacity)
+		return EINVAL;
+	if (count > commands->capacity - commands->used)
+		return ENOSPC;
+	return 0;
+}
+
+static uint32_t
+packet7(unsigned opcode, unsigned count)
+{
+	return 0x70000000u | count | (odd_parity(count) << 15) |
+	    (opcode << 16) | (odd_parity(opcode) << 23);
+}
+
+int
+a618_emit_reg_write(struct a618_commands *commands, uint32_t reg, uint32_t value)
+{
+	int error;
+	/* Register indices are DWORD indices, not byte offsets. */
+	if (reg > 0x3ffffu)
+		return EINVAL;
+	error = reserve(commands, 2);
+	if (error)
+		return error;
+	commands->words[commands->used++] = 0x40000001u | (reg << 8) |
+	    (odd_parity(reg) << 27); /* count=1 has odd parity already */
+	commands->words[commands->used++] = value;
+	return 0;
+}
+
+int
+a618_emit_memory_write(struct a618_commands *commands, uint64_t iova, uint32_t value)
+{
+	int error;
+	if ((iova & 3u) || iova >= (1ull << 49))
+		return EINVAL;
+	error = reserve(commands, 4);
+	if (error)
+		return error;
+	commands->words[commands->used++] = packet7(0x3d, 3); /* CP_MEM_WRITE */
+	commands->words[commands->used++] = (uint32_t)iova;
+	commands->words[commands->used++] = (uint32_t)(iova >> 32);
+	commands->words[commands->used++] = value;
+	return 0;
+}
+
+int
+a618_emit_fence(struct a618_commands *commands, uint64_t iova, uint32_t sequence)
+{
+	int error;
+	if ((iova & 3u) || iova >= (1ull << 49))
+		return EINVAL;
+	error = reserve(commands, 5);
+	if (error)
+		return error;
+	commands->words[commands->used++] = packet7(0x46, 4); /* CP_EVENT_WRITE */
+	/* CACHE_FLUSH_TS + IRQ, same event used by MSM a6xx_submit(). */
+	commands->words[commands->used++] = 4u | (1u << 31);
+	commands->words[commands->used++] = (uint32_t)iova;
+	commands->words[commands->used++] = (uint32_t)(iova >> 32);
+	commands->words[commands->used++] = sequence;
+	return 0;
+}
+
+int
+a618_ring_init(struct a618_ring *ring, uint32_t *words, unsigned size,
+    void *cookie, int (*read_rptr)(void *, unsigned *),
+    int (*publish)(void *, unsigned))
+{
+	/* A6xx ring length is a power of two. Keep one slot empty. The
+	 * hardware must already be configured for this length and RPTR=WPTR=0.
+	 */
+	if (!ring || !words || size < 2 || (size & (size - 1)) ||
+	    size > 0x100000u || !read_rptr || !publish)
+		return EINVAL;
+	ring->words = words;
+	ring->size = size;
+	ring->wptr = 0;
+	ring->poisoned = 0;
+	ring->cookie = cookie;
+	ring->read_rptr = read_rptr;
+	ring->publish = publish;
+	return 0;
+}
+
+int
+a618_ring_submit(struct a618_ring *ring, const struct a618_commands *commands)
+{
+	unsigned rptr, available, next;
+	int error;
+	if (!ring || !ring->words || !ring->read_rptr || !ring->publish ||
+	    ring->size < 2 || (ring->size & (ring->size - 1)) ||
+	    ring->wptr >= ring->size || !commands || !commands->words ||
+	    !commands->used || commands->used > commands->capacity)
+		return EINVAL;
+	if (ring->poisoned)
+		return EIO;
+	if (commands->used >= ring->size)
+		return ENOSPC;
+	error = ring->read_rptr(ring->cookie, &rptr);
+	if (error || rptr >= ring->size) {
+		ring->poisoned = 1;
+		return error ? error : EIO;
+	}
+	available = (rptr - ring->wptr - 1) & (ring->size - 1);
+	if (commands->used > available)
+		return EAGAIN; /* Caller may retry with a deadline, never busy-spin. */
+	next = ring->wptr;
+	for (unsigned i = 0; i < commands->used; ++i) {
+		ring->words[next] = commands->words[i];
+		next = (next + 1) & (ring->size - 1);
+	}
+	error = ring->publish(ring->cookie, next);
+	if (error) {
+		ring->poisoned = 1;
+		return error;
+	}
+	ring->wptr = next;
+	return 0;
+}
+#endif
diff --git a/bsd/dev/sweet_adreno.h b/bsd/dev/sweet_adreno.h
new file mode 100644
index 0000000..d6462ff
--- /dev/null
+++ b/bsd/dev/sweet_adreno.h
@@ -0,0 +1,84 @@
+/* SPDX-License-Identifier: MIT
+ * SWEET A618 hardware core. See docs/adreno-port.md for provenance/status.
+ */
+#ifndef SWEET_ADRENO_H
+#define SWEET_ADRENO_H
+#if defined(KERNEL)
+#include <sys/types.h>
+#else
+#include <stdint.h>
+#endif
+
+/* Offsets are bytes relative to the aperture supplied in cookie.
+ * write() must order prior stores and complete the MMIO store before return.
+ * The caller serializes device operations and keeps the rails voted on.
+ */
+struct a618_io {
+	void *cookie;
+	uint32_t (*read)(void *, uint32_t);
+	void (*write)(void *, uint32_t, uint32_t);
+	void (*delay_us)(void *, unsigned);
+};
+struct a618_power_result {
+	uint32_t control;
+	uint32_t status;
+	unsigned waited_us;
+};
+int a618_enable_cx(const struct a618_io *, struct a618_power_result *);
+
+/* CPU-side PM4 builder. No allocation, MMIO, firmware loading or submission.
+ * Caller supplies private, writable storage and owns all referenced IOVAs.
+ * A failed append leaves both the buffer and used count unchanged.
+ */
+struct a618_commands {
+	uint32_t *words;
+	unsigned capacity;
+	unsigned used;
+};
+int a618_emit_reg_write(struct a618_commands *, uint32_t, uint32_t);
+int a618_emit_memory_write(struct a618_commands *, uint64_t, uint32_t);
+int a618_emit_fence(struct a618_commands *, uint64_t, uint32_t);
+
+/* Single producer ring transport. Caller holds its device lock for init and
+ * submit, supplies coherent memory (or syncs it in publish), and guarantees
+ * CP/SQE, SMMU, power and clocks are initialized before attaching this ring.
+ * publish synchronizes the ENTIRE ring for DMA, orders writes, then writes
+ * CP_RB_WPTR. A failure poisons the ring: hardware ownership is uncertain.
+ * This API accepts trusted kernel-built packets only, never userspace PM4.
+ */
+struct a618_ring {
+	uint32_t *words;
+	unsigned size;
+	unsigned wptr;
+	int poisoned;
+	void *cookie;
+	int (*read_rptr)(void *, unsigned *);
+	int (*publish)(void *, unsigned);
+};
+int a618_ring_init(struct a618_ring *, uint32_t *, unsigned, void *,
+    int (*)(void *, unsigned *), int (*)(void *, unsigned));
+int a618_ring_submit(struct a618_ring *, const struct a618_commands *);
+
+/* postmarketOS SM7150 clock path; GX remains controlled by GMU firmware.
+ * Requires live CX power and parent MX/CX votes maintained by the caller.
+ * PLL0 must already be running at 600 MHz. Its rate is never changed.
+ * A failure leaves enabled clocks held and stops further operations.
+ */
+struct a618_clock_result {
+	unsigned block; /* 0 = GPUCC, 1 = GCC */
+	uint32_t offset;
+	uint32_t value;
+	unsigned completed;
+};
+int a618_enable_gmu_clocks(const struct a618_io *, const struct a618_io *,
+    struct a618_clock_result *);
+
+/* GMU-relative byte offsets, adjusted from Freedreno DWORD register IDs. */
+#define A618_GMU_SYSRESET 0x14000u
+#define A618_GMU_FW_INIT_RESULT 0x14070u
+#define A618_GMU_POWER_STATUS 0x14340u
+#define A618_GMU_AHB_FENCE_STATUS 0x24c4cu
+#define A618_GMU_ITCM 0x3000u
+int a618_gmu_stage_legacy(const struct a618_io *, const unsigned char *,
+    unsigned, uint32_t, unsigned *);
+#endif
diff --git a/bsd/dev/sweet_adreno_clock.c b/bsd/dev/sweet_adreno_clock.c
new file mode 100644
index 0000000..d43cd8c
--- /dev/null
+++ b/bsd/dev/sweet_adreno_clock.c
@@ -0,0 +1,239 @@
+/* SPDX-License-Identifier: MIT
+ * Copyright (c) 2026 ios-sweet contributors
+ *
+ * SM7150 clock and firmware-staging implementation using public Qualcomm
+ * interfaces. Source references: docs/adreno-port.md (postmarketOS section).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(KERNEL)
+#include <sys/errno.h>
+#else
+#include <errno.h>
+#endif
+#include "sweet_adreno.h"
+
+static int
+io_valid(const struct a618_io *io)
+{
+	return io && io->read && io->write && io->delay_us;
+}
+
+static int
+read_checked(const struct a618_io *io, unsigned block, uint32_t offset,
+    struct a618_clock_result *result)
+{
+	result->block = block;
+	result->offset = offset;
+	result->value = io->read(io->cookie, offset);
+	return result->value == 0xffffffffu ? EIO : 0;
+}
+
+static int
+update(const struct a618_io *io, unsigned block, uint32_t offset,
+    uint32_t mask, uint32_t value, struct a618_clock_result *result)
+{
+	int error = read_checked(io, block, offset, result);
+	if (error)
+		return error;
+	io->write(io->cookie, offset, (result->value & ~mask) | value);
+	error = read_checked(io, block, offset, result);
+	if (error)
+		return error;
+	return (result->value & mask) == value ? 0 : EIO;
+}
+
+static int
+poll(const struct a618_io *io, unsigned block, uint32_t offset,
+    uint32_t mask, uint32_t expected, struct a618_clock_result *result)
+{
+	for (unsigned elapsed = 0; elapsed < 500; ++elapsed) {
+		int error = read_checked(io, block, offset, result);
+		if (error)
+			return error;
+		if ((result->value & mask) == expected)
+			return 0;
+		io->delay_us(io->cookie, 1);
+	}
+	return ETIMEDOUT;
+}
+
+static int
+branch(const struct a618_io *io, unsigned block, uint32_t offset,
+    struct a618_clock_result *result)
+{
+	int error = update(io, block, offset, 1, 1, result);
+	if (error)
+		return error;
+	/* A running NOC FSM may report bit31 set; match Linux branch2 semantics. */
+	for (unsigned elapsed = 0; elapsed < 500; ++elapsed) {
+		error = read_checked(io, block, offset, result);
+		if (error)
+			return error;
+		if (!(result->value & (1u << 31)) ||
+		    ((result->value >> 28) & 7u) == 2) {
+			++result->completed;
+			return 0;
+		}
+		io->delay_us(io->cookie, 1);
+	}
+	return ETIMEDOUT;
+}
+
+int
+a618_enable_gmu_clocks(const struct a618_io *gpucc,
+    const struct a618_io *gcc, struct a618_clock_result *result)
+{
+	int error;
+	if (!result || !io_valid(gpucc) || !io_valid(gcc))
+		return EINVAL;
+	result->block = result->completed = 0;
+	result->offset = result->value = 0;
+	/* CX power and software control must still be established. */
+	error = read_checked(gpucc, 0, 0x106c, result);
+	if (error)
+		return error;
+	if (result->value & 3u)
+		return EAGAIN;
+	error = read_checked(gpucc, 0, 0x1540, result);
+	if (error)
+		return error;
+	if (!(result->value & (1u << 31)))
+		return EAGAIN;
+
+	/* GPLL0 is a shared, fixed FABIA PLL. Check 19.2 MHz * 31.25 = 600 MHz
+	 * before voting its output. Never reprogram this system PLL.
+	 */
+	error = read_checked(gcc, 1, 0x4, result);
+	if (error)
+		return error;
+	if (result->value != 31)
+		return ERANGE;
+	error = read_checked(gcc, 1, 0x38, result);
+	if (error)
+		return error;
+	if (result->value != 0x4000)
+		return ERANGE;
+	error = read_checked(gcc, 1, 0, result);
+	if (error)
+		return error;
+	if (result->value & (1u << 20)) {
+		/* FABIA in vote-FSM mode: Linux waits for ACTIVE, not LOCK_DET. */
+		error = update(gcc, 1, 0x52000, 1, 1, result);
+		if (!error)
+			error = poll(gcc, 1, 0, 1u << 30, 1u << 30, result);
+	} else {
+		/* Preserve an already running direct-control PLL. Its rate was
+		 * checked above; do not change MODE/OPMODE or pretend a vote
+		 * can start a PLL which is not under vote-FSM control.
+		 */
+		if ((result->value & ((1u << 31) | 1u)) != ((1u << 31) | 1u))
+			return EBUSY;
+		error = read_checked(gcc, 1, 0x2c, result);
+		if (!error && result->value != 1)
+			error = EBUSY;
+	}
+	if (error)
+		return error;
+	/* GCC_GPU_GPLL0_DIV_CLK_SRC: fixed divide by two, 300 MHz. */
+	error = update(gcc, 1, 0x52004, 1u << 16, 1u << 16, result);
+	if (error)
+		return error;
+	gcc->delay_us(gcc->cookie, 10);
+	/* Bus clocks named by the postmarketOS GMU and SMMU DT nodes. */
+	static const uint32_t bus[] = { 0x4452c, 0x7100c, 0x71018 };
+	for (unsigned i = 0; i < sizeof(bus) / sizeof(bus[0]); ++i) {
+		error = branch(gcc, 1, bus[i], result);
+		if (error)
+			return error;
+	}
+	/* SM7150 GMU requests CXO; its SMMU requests GPUCC AHB and GCC
+	 * GPU_SNOC_DVM_GFX. Neither requests GPUCC CXO_AON or CX_SNOC_DVM.
+	 * Those extra gates reject enable on sweet. Use the DT dependencies
+	 * and retain status checks on each required branch. No GX clock or
+	 * GPUCC PLL0/PLL1 register is touched.
+	 */
+	error = branch(gpucc, 0, 0x109c, result);
+	if (!error)
+		error = branch(gpucc, 0, 0x1078, result);
+	if (error)
+		return error;
+	/* RCG2 force-enable while selecting/dividing the existing GCC parent. */
+	error = update(gpucc, 0, 0x1120, 2, 2, result);
+	if (error)
+		return error;
+	error = poll(gpucc, 0, 0x1120, 1u << 31, 0, result);
+	if (error)
+		return error;
+	/* SRC_SEL=6, HID_DIV=2: 300 MHz * 2 / (2+1) = 200 MHz. */
+	error = update(gpucc, 0, 0x1124, 0x10371fu, 0x602, result);
+	if (error)
+		return error;
+	/* UPDATE is self-clearing; do not require immediate readback of bit0. */
+	error = read_checked(gpucc, 0, 0x1120, result);
+	if (error)
+		return error;
+	gpucc->write(gpucc->cookie, 0x1120, result->value | 1u);
+	error = poll(gpucc, 0, 0x1120, 1, 0, result);
+	if (error)
+		return error;
+	error = read_checked(gpucc, 0, 0x1124, result);
+	if (error)
+		return error;
+	if ((result->value & 0x10371fu) != 0x602)
+		return EIO;
+	/* Source probe recommends all four WAKE/SLEEP bits before GMU enable. */
+	error = update(gpucc, 0, 0x1098, 0xff0, 0xff0, result);
+	if (!error)
+		error = branch(gpucc, 0, 0x1098, result);
+	/* Leave the root held on for staging; shutdown belongs to the runtime
+	 * state machine once firmware and SMMU execution are implemented.
+	 */
+	return error;
+}
+
+static uint32_t
+little_word(const unsigned char *data)
+{
+	return (uint32_t)data[0] | ((uint32_t)data[1] << 8) |
+	    ((uint32_t)data[2] << 16) | ((uint32_t)data[3] << 24);
+}
+
+int
+a618_gmu_stage_legacy(const struct a618_io *gmu, const unsigned char *firmware,
+    unsigned size, uint32_t expected_crc, unsigned *verified)
+{
+	uint32_t crc = 0xffffffffu, sp, pc, reset;
+	if (!verified)
+		return EINVAL;
+	*verified = 0;
+	if (!io_valid(gmu) || !firmware || size != 0x8000)
+		return EINVAL;
+	/* Validate all data before issuing any MMIO. */
+	sp = little_word(firmware);
+	pc = little_word(firmware + 4);
+	if ((sp & 7) || sp < 0x40000 || sp > 0x44000 || !(pc & 1) ||
+	    (pc & ~1u) >= size)
+		return EINVAL;
+	for (unsigned i = 0; i < size; ++i) {
+		crc ^= firmware[i];
+		for (unsigned bit = 0; bit < 8; ++bit)
+			crc = (crc >> 1) ^ ((0u - (crc & 1u)) & 0xedb88320u);
+	}
+	if ((crc ^ 0xffffffffu) != expected_crc)
+		return EIO;
+	reset = gmu->read(gmu->cookie, A618_GMU_SYSRESET);
+	if (reset == 0xffffffffu)
+		return EIO;
+	if (!(reset & 1))
+		return EBUSY; /* Never overwrite a potentially running processor. */
+	for (unsigned offset = 0; offset < size; offset += 4) {
+		uint32_t word = little_word(firmware + offset);
+		gmu->write(gmu->cookie, A618_GMU_ITCM + offset, word);
+		if (gmu->read(gmu->cookie, A618_GMU_ITCM + offset) != word)
+			return EIO;
+		*verified += 4;
+	}
+	reset = gmu->read(gmu->cookie, A618_GMU_SYSRESET);
+	return reset != 0xffffffffu && (reset & 1) ? 0 : EIO;
+}
+#endif
diff --git a/bsd/dev/sweet_adreno_pas.c b/bsd/dev/sweet_adreno_pas.c
new file mode 100644
index 0000000..27d080f
--- /dev/null
+++ b/bsd/dev/sweet_adreno_pas.c
@@ -0,0 +1,117 @@
+/* SPDX-License-Identifier: MIT
+ * Restricted SM7150 signed-ZAP PAS transport (public Qualcomm SCM protocol).
+ * No generic SCM entry point, memory-assignment or security-register bypass.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include "sweet_adreno_cp.h"
+static uint32_t
+le32(const unsigned char *p)
+{
+ return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+     ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+static int
+scm(unsigned service, unsigned command, uint64_t arguments,
+ uint64_t arg0, uint64_t arg1, uint64_t arg2, uint64_t arg3,
+ struct a618_pas_result *result)
+{
+ uint64_t function = 0x42000000u | (service << 8) | command;
+ for (unsigned busy = 0; busy < 5; ++busy) {
+  uint64_t resume = function, quirk_a6 = 0;
+  for (unsigned interrupted = 0; interrupted < 32; ++interrupted) {
+   register uint64_t x0 __asm__("x0") = resume;
+   register uint64_t x1 __asm__("x1") = arguments;
+   register uint64_t x2 __asm__("x2") = arg0;
+   register uint64_t x3 __asm__("x3") = arg1;
+   register uint64_t x4 __asm__("x4") = arg2;
+   register uint64_t x5 __asm__("x5") = arg3;
+   register uint64_t x6 __asm__("x6") = quirk_a6;
+   register uint64_t x7 __asm__("x7") = 0;
+   __asm__ volatile("dsb sy\n\tsmc #0\n\tdsb sy" :
+       "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3),
+       "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7) : :
+       "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15",
+       "x16", "x17", "memory", "cc");
+   result->status = (int64_t)x0;
+   result->response = x1;
+   if (x0 == 1) { resume = 1; quirk_a6 = x6; continue; }
+   if ((int64_t)x0 == -12) break; /* bounded busy retry */
+   if (x0) return x0 == (uint64_t)-1 ? ENOTSUP : EIO;
+   return 0;
+  }
+  if (result->status != -12) return ETIMEDOUT;
+  if (busy != 4) delay(30000);
+ }
+ return EBUSY;
+}
+/* Public SCM aperture protocol used by the pinned Linux Adreno driver.
+ * Availability is optional; an advertised call that fails is fatal. The four
+ * arguments fit x2..x5 directly, so no shared extended-argument buffer exists.
+ * This entry cannot select another context or issue arbitrary SCM commands. */
+int
+a618_cp_configure_aperture(struct a618_pas_result *result)
+{
+ if (!result) return EINVAL;
+ *result = (struct a618_pas_result){ .phase = 1 };
+ int error = scm(6, 1, 1, 0x02000c1b, 0, 0, 0, result);
+ /* Linux treats a failed availability query as unavailable. It has no
+  * configuration side effects; retain raw status for the boot log. */
+ if (error) return 0;
+ if (!result->response) return 0; /* optional MP command unavailable */
+ result->phase = 2;
+ error = scm(0x0c, 0x1b, 4, 0xffff0000, 0xffffffffu,
+     0xffffffffu, 0xffffffffu, result);
+ if (error) return error;
+ result->phase = 3;
+ return 0;
+}
+int
+a618_zap_authenticate(volatile uint32_t *reserved, uint64_t physical,
+ const struct a618_dma_region *metadata, const unsigned char *mdt,
+ unsigned mdt_bytes, const unsigned char *code, unsigned code_bytes,
+ struct a618_pas_result *result)
+{
+ if (!result) return EINVAL;
+ *result = (struct a618_pas_result){0};
+ if (!reserved || physical != 0x93b15000ull || !metadata || !metadata->cpu ||
+     metadata->bytes != 0x4000 || !metadata->uncached ||
+     !metadata->physical || (metadata->physical & 0x3fff) ||
+     metadata->physical >= (1ull << 36) || !mdt || !code ||
+     mdt_bytes != 0x1acc || code_bytes != 0x7c0 ||
+     le32(mdt) != 0x464c457f || mdt[4] != 1 || mdt[5] != 1 ||
+     le32(mdt + 28) != 52 || (le32(mdt + 44) & 0xffff) != 3 || le32(mdt + 40) != 0x00200034 ||
+     le32(mdt + 52 + 2 * 32) != 1 ||
+     le32(mdt + 52 + 2 * 32 + 12) != 0x5000 ||
+     le32(mdt + 52 + 2 * 32 + 16) != code_bytes ||
+     le32(mdt + 52 + 2 * 32 + 20) != code_bytes ||
+     le32(mdt + 52 + 2 * 32 + 24) != 0x08000007) return EINVAL;
+ result->phase = 1;
+ const unsigned commands[] = {1, 2, 5};
+ for (unsigned i = 0; i < 3; ++i) {
+  int error = scm(6, 1, 1, 0x02000200u | commands[i], 0, 0, 0, result);
+  if (error) return error;
+  if (!result->response) return ENOTSUP;
+ }
+ volatile uint32_t *words = (volatile uint32_t *)metadata->cpu;
+ for (unsigned i = 0; i < mdt_bytes / 4; ++i) words[i] = le32(mdt + i * 4);
+ __asm__ volatile("dsb sy" ::: "memory");
+ result->phase = 2;
+ int error = scm(2, 1, 0x82, 13, metadata->physical, 0, 0, result);
+ if (error || result->response) return error ? error : EACCES;
+ /* TZ may now protect metadata. Retain its separate page and do not read,
+  * modify, free or reuse it, including on errors below. */
+ result->phase = 3;
+ error = scm(2, 2, 3, 13, physical, 0x1000, 0, result);
+ if (error || result->response) return error ? error : EACCES;
+ for (unsigned i = 0; i < 0x1000 / 4; ++i) reserved[i] = 0;
+ for (unsigned i = 0; i < code_bytes / 4; ++i) reserved[i] = le32(code + i * 4);
+ __asm__ volatile("dsb sy" ::: "memory");
+ result->phase = 4;
+ error = scm(2, 5, 1, 13, 0, 0, 0, result);
+ if (error || result->response) return error ? error : EACCES;
+ result->phase = 5;
+ return 0;
+}
+#endif
diff --git a/bsd/dev/sweet_adreno_smmu.c b/bsd/dev/sweet_adreno_smmu.c
new file mode 100644
index 0000000..e27c05c
--- /dev/null
+++ b/bsd/dev/sweet_adreno_smmu.c
@@ -0,0 +1,157 @@
+/* SPDX-License-Identifier: MIT
+ * Original bounded SMMUv2 backend using the ARM architecture and public
+ * Linux/Qualcomm register protocols. See docs/adreno-port.md for source pins.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(KERNEL)
+#include <sys/errno.h>
+#else
+#include <errno.h>
+#endif
+#include "sweet_adreno_dma.h"
+#define CB1 0x9000u
+#define ASID 0x61u
+/* FSR.Format[10:9] is read-only metadata, not a W1C fault. */
+#define FSR_FAULT 0xc00001feu
+static int
+put(const struct a618_io *io, uint32_t offset, uint32_t value,
+ uint32_t mask, struct a618_smmu_result *r)
+{
+ io->write(io->cookie, offset, value);
+ r->offset = offset; r->value = io->read(io->cookie, offset);
+ return r->value != 0xffffffffu && (r->value & mask) == (value & mask) ? 0 : EIO;
+}
+static int
+wait_clear(const struct a618_io *io, uint32_t offset, unsigned mask,
+ struct a618_smmu_result *r)
+{
+ for (unsigned i = 0; i < 500; ++i) {
+  r->offset = offset; r->value = io->read(io->cookie, offset);
+  if (r->value == 0xffffffffu) return EIO;
+  if (!(r->value & mask)) return 0;
+  io->delay_us(io->cookie, 1);
+ }
+ return ETIMEDOUT;
+}
+int
+a618_smmu_prepare(const struct a618_smmu_io *ops,
+ const struct a618_dma_region *memory, struct a618_smmu_result *r)
+{
+ if (!ops || !memory || !r || !ops->registers.read ||
+     !ops->registers.write || !ops->registers.delay_us ||
+     !ops->read64 || !ops->write64 || !ops->barrier || !memory->cpu ||
+     !memory->uncached || memory->bytes != A618_DMA_BYTES ||
+     (memory->physical & 0x3fff) || !memory->physical ||
+     memory->physical > (1ull << 36) - A618_DMA_BYTES ||
+     ((uintptr_t)memory->cpu & 7)) return EINVAL;
+ const struct a618_io *io = &ops->registers;
+ *r = (struct a618_smmu_result){ .context = 1, .slot = 0xffffffffu };
+ /* Measured 0091 profile: 4 KiB register pages, 0x8000 CB base, five
+  * stream match slots and context banks, 36-bit PA. 16K PT granules are
+  * intentionally not used (Qualcomm advertises broken 16K support).
+  */
+ const uint32_t identity[] = {0x48016605, 0x20008005, 0x7511};
+ for (unsigned i = 0; i < 3; ++i) {
+  r->offset = 0x20 + 4 * i; r->value = io->read(io->cookie, r->offset);
+  if (r->value != identity[i]) return ENOTSUP;
+ }
+ /* Do not steal an active bank or matching stream, even if its firmware
+  * owner appears idle. CB0 and all protected banks are left alone.
+  */
+ r->offset = CB1; r->value = io->read(io->cookie, CB1);
+ if (r->value == 0xffffffffu) return EIO;
+ if (r->value & 1) return EBUSY; /* M=0 is disabled; other reset bits may be UNKNOWN. */
+ for (unsigned i = 0; i < 5; ++i) {
+  r->offset = 0x800 + 4 * i;
+  uint32_t smr = r->value = io->read(io->cookie, r->offset);
+  if (smr == 0xffffffffu) return EIO;
+  if (!(smr & 0x80000000u)) {
+   if (r->slot == 0xffffffffu) r->slot = i;
+  } else if (((smr ^ 5u) & ~((smr >> 16) & 0x7fffu) & 0xffffu) == 0) {
+   r->slot = i; return EBUSY;
+  }
+ }
+ if (r->slot == 0xffffffffu) return ENOSPC;
+ r->control = io->read(io->cookie, 0);
+ if (r->control == 0xffffffffu) return EIO;
+ /* Three 4K tables inside a 16K host page; no mapping of the table arena.
+  * L1[1] -> L2[256] -> L3[0..15]: shared 64K at 0x60000000.
+  * All other entries fault. Both privileged/unprivileged data R/W, NX,
+  * Normal NC and outer shareable match the uncached CPU mapping.
+  */
+ volatile uint64_t *l1 = (volatile uint64_t *)memory->cpu;
+ volatile uint64_t *l2 = (volatile uint64_t *)(memory->cpu + 0x1000);
+ volatile uint64_t *l3 = (volatile uint64_t *)(memory->cpu + 0x2000);
+ for (unsigned i = 0; i < 512; ++i) l1[i] = l2[i] = l3[i] = 0;
+ l1[1] = (memory->physical + 0x1000) | 3;
+ l2[256] = (memory->physical + 0x2000) | 3;
+ for (unsigned i = 0; i < 16; ++i)
+  l3[i] = (memory->physical + A618_TABLE_BYTES + 0x1000 * i) |
+      (3ull << 53) | (1u << 11) | (1u << 10) | (2u << 8) | (1u << 6) | 3;
+ ops->barrier(io->cookie);
+ int error;
+ #define SET(o,v,m) do { error = put(io, (o), (v), (m), r); if (error) return error; } while (0)
+ SET(0x1804, 1, 1); /* GR1 CBA2R(1): AArch64. */
+ SET(0x1004, 0x1f300, 0x3f3ff); /* Stage1, stage2 bypass, weak upstream attributes. */
+ SET(CB1 + 0x10, 0x38011, 0x38077); /* TCR2: SEP upstream, 36-bit output, AArch64 ASID. */
+ SET(CB1 + 0x30, 0x00802020u, 0x00c0ffbfu); /* EPD1, OSH, NC walks, T0SZ=32; AArch64, no EAE. */
+ uint64_t ttbr = memory->physical | ((uint64_t)ASID << 48);
+ ops->write64(io->cookie, CB1 + 0x20, ttbr);
+ r->offset = CB1 + 0x20;
+ r->par = ops->read64(io->cookie, r->offset);
+ if ((r->par & 0xffff000ffffff000ull) != ttbr) return EIO;
+ ops->write64(io->cookie, CB1 + 0x28, 0);
+ SET(CB1 + 0x38, 0x44, 0xff); /* MAIR[0]: Normal NC. */
+ /* MAIR1 is unused: every data PTE references MAIR0[0]. */
+ /* Fault reporting enabled, IRQ/stalling disabled until an IRQ handler
+  * exists; HUPCF continues other transactions after an abort.
+  */
+ /* AFE/TRE are UNK/SBOP for long descriptors: write ones, do not
+  * compare their readback. Check M, E, fault controls, WXN and ASIDPNE.
+  */
+ SET(CB1, 0x1127, 0x17f1);
+ /* Block unmatched streams and enable this device. Preserve other controls;
+  * do not enable interrupt sources without handlers. No reset-all/TLBI-all.
+  */
+ SET(0, (r->control | 0x1c12u) & ~0xe025u, 0xfc37);
+ io->write(io->cookie, CB1 + 0x610, ASID);
+ io->write(io->cookie, CB1 + 0x7f0, 0);
+ error = wait_clear(io, CB1 + 0x7f4, 1, r);
+ if (error) return error;
+ /* Hardware translation probes, not a software table walk: every shared
+  * page plus a guard fault must match before the stream is published.
+  */
+ for (unsigned i = 0; i <= 16; ++i) {
+  uint64_t va = (uint64_t)A618_SHARED_IOVA + i * 0x1000u;
+  ops->write64(io->cookie, CB1 + 0x800, va);
+  error = wait_clear(io, CB1 + 0x8f0, 1, r);
+  if (error) return error;
+  r->par = ops->read64(io->cookie, CB1 + 0x50);
+  if (r->par == 0xffffffffffffffffull) return EIO;
+  if (i == 16) {
+   if (!(r->par & 1)) return EFAULT;
+  } else {
+   uint64_t expected = memory->physical + A618_TABLE_BYTES + i * 0x1000u;
+   if ((r->par & 1) || (r->par & 0x0000000ffffff000ull) != expected)
+    return EFAULT;
+   ++r->translated;
+  }
+ }
+ r->fault = io->read(io->cookie, CB1 + 0x58);
+ if (r->fault == 0xffffffffu) return EIO;
+ if (r->fault & (1u << 30)) return EBUSY; /* Never resume an unknown stall. */
+ if (r->fault & FSR_FAULT) {
+  io->write(io->cookie, CB1 + 0x58, r->fault & (FSR_FAULT & ~(1u << 30)));
+  uint32_t after = io->read(io->cookie, CB1 + 0x58);
+  if (after == 0xffffffffu || (after & FSR_FAULT)) return EIO;
+ }
+ /* Only GMU kernel stream 5: route first, VALID last. Never program
+  * GMU user stream 4, GPU stream 0, broad masks or a bypass entry.
+  */
+ SET(0xc00 + 4 * r->slot, 1, 0x030300ff);
+ SET(0x800 + 4 * r->slot, 0x80000005u, 0xffffffffu);
+ r->fault = io->read(io->cookie, CB1 + 0x58);
+ #undef SET
+ return r->fault == 0xffffffffu || (r->fault & FSR_FAULT) ? EIO : 0;
+}
+#endif
diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
new file mode 100644
index 0000000..638a4d5
--- /dev/null
+++ b/bsd/dev/sweet_gpu.c
@@ -0,0 +1,808 @@
+/*
+ * SWEET Adreno 618 bring-up. sweetgpu=1 reads GPUCC and command DB only.
+ * sweetgpu=2 adds deferred RPMh ARC READ transactions after touch power.
+ * sweetgpu=3 additionally raises only gfx.lvl and verifies the readback.
+ * sweetgpu=4 uses the new A618 core to power CX after fresh rail checks.
+ * sweetgpu=5 enables GMU/bus clocks and reads CX-side GMU/SMMU status.
+ * sweetgpu=6 additionally stages firmware while the M3 remains in reset.
+ * sweetgpu=7 additionally validates SMMU mappings and prepares HFI RAM.
+ * sweetgpu=8 cold-starts legacy GMU and exchanges real HFI messages.
+ * GX is firmware controlled. No CP/SQE or graphics submission yet.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/errno.h>
+#include "sweet_adreno.h"
+#include "sweet_adreno_cp.h"
+#include "sweet_adreno_dma.h"
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern int sweet_rpmh_arc_probe(const char *res);
+extern int sweet_rpmh_arc_read(const char *res);
+extern int sweet_rpmh_arc_require(const char *res, unsigned minimum);
+extern int sweet_rpmh_arc_raise(const char *res, unsigned target_vlvl);
+extern kern_return_t thread_terminate(thread_t);
+extern int sweet_rpmh_adreno_level_vote(unsigned level, uint32_t *vote, unsigned *mx_level);
+void sweet_gpu_probe(void);
+
+
+/* LOW_SVS is the first safe GPU corner; the write only raises gfx.lvl. */
+#define SWEET_GPU_GFX_TARGET 65u
+
+#define SWEET_GPUCC_PA       0x05090000u
+#define SWEET_GPUCC_SIZE     0x00009000u
+#define SWEET_GCC_PA         0x00100000u
+#define SWEET_GCC_SIZE       0x00072000u
+#define SWEET_GMU_PA         0x0506a000u
+#define SWEET_GMU_SIZE       0x00031000u
+#define SWEET_SMMU_PA        0x05040000u
+#define SWEET_SMMU_SIZE      0x00010000u
+#define GPU_CC_GX_BCR        0x1008u
+#define GPU_CC_GX_GDSCR      0x100cu
+#define GPU_CC_CX_GDSCR      0x106cu
+#define GPU_CC_CBCR_AHB      0x1078u
+#define GPU_CC_GX_DOMAIN     0x1508u
+#define GPU_CC_CX_HW_CTRL    0x1540u
+#define GDSC_PWR_ON          (1u << 31)
+#define GDSC_SW_COLLAPSE     (1u << 0)
+#define GDSC_HW_CONTROL      (1u << 1)
+#define GX_DOMAIN_CLAMP      (1u << 0)
+#define GX_BCR_BLK_ARES      (1u << 0)
+#define BRANCH_CLK_OFF       (1u << 31)
+#define BRANCH_CLK_ENABLE    (1u << 0)
+
+static vm_offset_t sweet_gpucc;
+static int sweet_gpu_probe_attempted;
+static int sweet_gpu_stage;
+
+/* All registers below are in GPUCC; none is in the Adreno/GMU aperture. */
+static const struct {
+	const char *name;
+	uint32_t offset;
+} sweet_gpu_branches[] = {
+	{ "AHB",          0x1078u },
+	{ "CX_APB",       0x1088u },
+	{ "CX_SNOC_DVM",  0x108cu },
+	{ "CX_GMU",       0x1098u },
+	{ "CXO",          0x109cu },
+	{ "CX_GFX3D",     0x10a4u },
+	{ "CX_GFX3D_SLV", 0x10a8u },
+	{ "GX_GFX3D",     0x1054u },
+	{ "GX_CXO",       0x1060u },
+	{ "GX_GMU",       0x1064u },
+};
+
+static uint32_t
+sweet_gpucc_read(uint32_t offset)
+{
+	uint32_t value = *(volatile uint32_t *)(sweet_gpucc + offset);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+/* XNU adapter: cookie is the mapped aperture base. */
+static uint32_t
+sweet_adreno_read(void *cookie, uint32_t offset)
+{
+	uint32_t value = *(volatile uint32_t *)((vm_offset_t)cookie + offset);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+static void
+sweet_adreno_write(void *cookie, uint32_t offset, uint32_t value)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)((vm_offset_t)cookie + offset) = value;
+	__asm__ volatile("dsb oshst" ::: "memory");
+	(void)sweet_adreno_read(cookie, offset);
+}
+
+static uint64_t
+sweet_adreno_read64(void *cookie, uint32_t offset)
+{
+ uint64_t value = *(volatile uint64_t *)((vm_offset_t)cookie + offset);
+ __asm__ volatile("dmb oshld" ::: "memory");
+ return value;
+}
+static void
+sweet_adreno_write64(void *cookie, uint32_t offset, uint64_t value)
+{
+ __asm__ volatile("dmb oshst" ::: "memory");
+ *(volatile uint64_t *)((vm_offset_t)cookie + offset) = value;
+ __asm__ volatile("dsb oshst" ::: "memory");
+}
+static void
+sweet_adreno_barrier(void *cookie)
+{
+ (void)cookie;
+ __asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+sweet_adreno_delay(void *cookie, unsigned usec)
+{
+	(void)cookie;
+	delay(usec);
+}
+
+/*
+ * Pure metadata inspection; valid tables do not establish current votes.
+ */
+static int
+sweet_gpu_arc_tables(void)
+{
+	static const char *const names[] = { "mx.lvl", "cx.lvl", "gfx.lvl" };
+	for (unsigned i = 0; i < 3; ++i) {
+		int error = sweet_rpmh_arc_probe(names[i]);
+		if (error) {
+			printf("SWEET GPU: ARC probe %s failed %d\n", names[i], error);
+			return error;
+		}
+	}
+	printf("SWEET GPU: ARC tables read-only complete\n");
+	return 0;
+}
+
+/* Fresh resource checks belong to this boot, not to a previous stage.
+ * ARC table selectors are the current board interpretation, not a voltage
+ * measurement. Shared rails are never lowered or written by this driver.
+ */
+static int
+sweet_gpu_power_cx(void)
+{
+	struct a618_power_result result;
+	const struct a618_io io = {
+		.cookie = (void *)sweet_gpucc,
+		.read = sweet_adreno_read,
+		.write = sweet_adreno_write,
+		.delay_us = sweet_adreno_delay,
+	};
+	int error = sweet_rpmh_arc_require("mx.lvl", 65);
+	if (!error)
+		error = sweet_rpmh_arc_require("cx.lvl", 65);
+	if (error) {
+		printf("SWEET ADRENO: CX preconditions failed errno=%d; no GPUCC write\n", error);
+		return error;
+	}
+	error = a618_enable_cx(&io, &result);
+	printf("SWEET ADRENO: CX result errno=%d control=%#x status=%#x waited_us=%u\n",
+	    error, result.control, result.status, result.waited_us);
+	return error;
+}
+
+static uint32_t
+sweet_gpu_crc(const unsigned char *bytes, unsigned length)
+{
+ uint32_t crc = 0xffffffffu;
+ for (unsigned i = 0; i < length; ++i) {
+  crc ^= bytes[i];
+  for (unsigned b = 0; b < 8; ++b) crc = (crc >> 1) ^ (0xedb88320u & (0u - (crc & 1)));
+ }
+ return ~crc;
+}
+static int
+sweet_gpu_blob(DTEntry node, const char *name, const char *crc_name,
+ const unsigned char **bytes, unsigned *length)
+{
+ const uint32_t *crc;
+ unsigned size = 0;
+ if (SecureDTGetProperty(node, name, (const void **)bytes, length) != kSuccess ||
+     SecureDTGetProperty(node, crc_name, (const void **)&crc, &size) != kSuccess ||
+     size != 4 || *length > 0x8000 || !*length) return ENOENT;
+ return sweet_gpu_crc(*bytes, *length) == *crc ? 0 : EIO;
+}
+struct sweet_gpu_zap_request {
+ volatile uint32_t *reserved;
+ uint64_t physical;
+ const struct a618_dma_region *metadata;
+ const unsigned char *mdt, *code;
+ unsigned mdt_bytes, code_bytes;
+ struct a618_pas_result result;
+};
+static int
+sweet_gpu_zap_prepare(void *cookie)
+{
+ struct sweet_gpu_zap_request *request = cookie;
+ if (!request) return EINVAL;
+ return a618_zap_authenticate(request->reserved, request->physical,
+     request->metadata, request->mdt, request->mdt_bytes, request->code,
+     request->code_bytes, &request->result);
+}
+/*
+ * GPU performance levels from the pinned sm7150.dtsi gpu_opp_table, every
+ * one opp-supported-hw 0x1f (all speed bins): kHz and raw RPMh opp-level.
+ * Bring-up still runs at index 1 (267MHz, the proven corner). After the CP
+ * fence succeeds the APPS gfx/mx floors are raised for the chosen level, the
+ * GX clock is measured, DCVS selects it, and the clock is measured again.
+ * sweetgpukhz=267000 keeps the previous single-level behaviour.
+ */
+static const struct { uint32_t khz, level; } sweet_gpu_opps[] = {
+	{ 267000u, 64u },       /* LOW_SVS */
+	{ 355000u, 128u },      /* SVS */
+	{ 430000u, 192u },      /* SVS_L1 */
+	{ 565000u, 256u },      /* NOM */
+	/* 0132 telemetry: blur-heavy CoreAnimation commits are GPU-bound (13-14
+	 * passes, up to 15.5Mpx, 51-182ms at ~557MHz). OrangeFox KGSL on this
+	 * phone lists 650 and 800MHz; the pinned table pairs them with NOM_L1 and
+	 * TURBO (opp-supported-hw 0x1d / 0x19). */
+	{ 650000u, 320u },      /* NOM_L1 */
+	{ 800000u, 384u },      /* TURBO */
+};
+static unsigned sweet_gpu_opp_mx[6];
+
+static void
+sweet_gpu_levels_prepare(void)
+{
+	uint32_t target = 565000u;
+	PE_parse_boot_argn("sweetgpukhz", &target, sizeof(target));
+	a618_gpu_level_count = 0;
+	unsigned count = 0;
+	for (unsigned i = 0; i < sizeof(sweet_gpu_opps) / sizeof(sweet_gpu_opps[0]); ++i) {
+		if (sweet_gpu_opps[i].khz > target) {
+			break;
+		}
+		uint32_t vote = 0;
+		unsigned mx = 0;
+		int error = sweet_rpmh_adreno_level_vote(sweet_gpu_opps[i].level, &vote, &mx);
+		if (error) {
+			printf("SWEET ADRENO: OPP %u kHz vote errno=%d; single legacy level\n",
+			    sweet_gpu_opps[i].khz, error);
+			return;
+		}
+		a618_gpu_levels[count].vote = vote;
+		a618_gpu_levels[count].khz = sweet_gpu_opps[i].khz;
+		sweet_gpu_opp_mx[count] = mx;
+		++count;
+	}
+	/* Only a table that begins with the proven 267MHz/raw64 corner. */
+	if (count < 2 || (a618_gpu_levels[0].vote >> 16) != 64u) {
+		printf("SWEET ADRENO: OPP table count=%u first=%#x; single legacy level\n",
+		    count, count ? a618_gpu_levels[0].vote : 0);
+		return;
+	}
+	a618_gpu_level_count = count;
+	printf("SWEET ADRENO: OPP table %u levels up to %u kHz (target %u)\n",
+	    count, a618_gpu_levels[count - 1].khz, target);
+}
+
+/* RBBM_PERFCTR_RBBM_0 with countable PERF_RBBM_ALWAYS_COUNT (GX core clock
+ * cycles) against the architected 19.2MHz timer. 0 means not measurable. */
+static uint64_t
+sweet_gpu_counter(vm_offset_t core)
+{
+	uint32_t hi, lo, again;
+	do {
+		hi = sweet_adreno_read((void *)core, 0x41d * 4);
+		lo = sweet_adreno_read((void *)core, 0x41c * 4);
+		again = sweet_adreno_read((void *)core, 0x41d * 4);
+	} while (hi != again);
+	return ((uint64_t)hi << 32) | lo;
+}
+
+static uint32_t
+sweet_gpu_measure_khz(vm_offset_t core)
+{
+	sweet_adreno_write((void *)core, 0x500 * 4, 1);         /* RBBM_PERFCTR_CNTL */
+	sweet_adreno_write((void *)core, 0x507 * 4, 0);         /* RBBM_SEL_0: ALWAYS_COUNT */
+	sweet_adreno_barrier(NULL);
+	delay(100);
+	const uint64_t c0 = sweet_gpu_counter(core), t0 = mach_absolute_time();
+	delay(20000);
+	const uint64_t c1 = sweet_gpu_counter(core), t1 = mach_absolute_time();
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(t1 - t0, &ns);
+	if (!ns || c1 <= c0 || (c1 >> 63) || c0 == 0xffffffffffffffffULL) {
+		return 0;
+	}
+	return (uint32_t)(((c1 - c0) * 1000000ULL) / ns);
+}
+
+/* Read-only GPUCC view of the real GX clock (Lineage gpucc-sm6150.c): alpha
+ * PLLs at +0x0/+0x100 (L +4, ALPHA +8, ALPHA_U +0xc, USER_CTL +0x10) feed
+ * gpu_cc_gx_gfx3d_clk_src (CMD_RCGR 0x101c, CFG 0x1020: SRC_SEL [10:8],
+ * SRC_DIV [4:0]) through a CRC divider. Logged raw with the VCO estimate. */
+static void
+sweet_gpu_clock_regs(const char *tag)
+{
+	if (!sweet_gpucc) {
+		return;
+	}
+	for (unsigned pll = 0; pll < 2; ++pll) {
+		const uint32_t base = pll * 0x100u;
+		const uint32_t l = sweet_gpucc_read(base + 0x4) & 0xffffu;
+		const uint32_t alpha = sweet_gpucc_read(base + 0x8), alpha_u = sweet_gpucc_read(base + 0xc) & 0xffu;
+		const uint64_t frac = ((uint64_t)alpha_u << 32) | alpha;
+		const uint64_t khz = 19200ULL * l + ((19200ULL * frac) >> 40);
+		printf("SWEET ADRENO: %s GPU PLL%u mode=%#x L=%u alpha=%#llx user_ctl=%#x vco~%llu kHz\n", tag, pll,
+		    sweet_gpucc_read(base), l, (unsigned long long)frac, sweet_gpucc_read(base + 0x10), (unsigned long long)khz);
+	}
+	const uint32_t cmd = sweet_gpucc_read(0x101c), cfg = sweet_gpucc_read(0x1020);
+	printf("SWEET ADRENO: %s gfx3d RCG cmd=%#x cfg=%#x src_sel=%u src_div=%u crc_fsm=%#x crc_mnd=%#x\n", tag, cmd, cfg,
+	    (cfg >> 8) & 7, cfg & 0x1f, sweet_gpucc_read(0x1024), sweet_gpucc_read(0x1028));
+}
+
+static void
+sweet_gpu_raise_clock(vm_offset_t core, vm_offset_t gmu)
+{
+	sweet_gpu_clock_regs("before DCVS");
+	const uint32_t before = sweet_gpu_measure_khz(core);
+	printf("SWEET ADRENO: GX clock measured=%u kHz at perf index 1 (configured %u kHz)\n",
+	    before, a618_gpu_level_count ? a618_gpu_levels[0].khz : 267000u);
+	if (a618_gpu_level_count < 2) {
+		return;
+	}
+	const unsigned top = a618_gpu_level_count - 1;
+	const unsigned gfx_vlvl = (a618_gpu_levels[top].vote >> 16) + 1;   /* ARC consumer level */
+	const unsigned mx_vlvl = sweet_gpu_opp_mx[top] + 1;
+	int error = sweet_rpmh_arc_raise("mx.lvl", mx_vlvl);
+	if (!error) {
+		error = sweet_rpmh_arc_raise("gfx.lvl", gfx_vlvl);
+	}
+	if (error) {
+		printf("SWEET ADRENO: APPS rail floor errno=%d; GX stays at perf index 1\n", error);
+		return;
+	}
+	const struct a618_io gmu_io = {(void *)gmu,
+	    sweet_adreno_read, sweet_adreno_write, sweet_adreno_delay};
+	error = a618_gmu_dcvs(&gmu_io, top + 1);
+	const uint32_t after = sweet_gpu_measure_khz(core);
+	printf("SWEET ADRENO: DCVS perf index %u (%u kHz, gfx vlvl %u, mx vlvl %u) errno=%d; GX clock measured=%u kHz\n",
+	    top + 1, a618_gpu_levels[top].khz, gfx_vlvl, mx_vlvl, error, after);
+	sweet_gpu_clock_regs("after DCVS");
+	if (error && error != ETIMEDOUT) {
+		/* Firmware refused: request the proven bring-up index again. */
+		int back = a618_gmu_dcvs(&gmu_io, 1);
+		printf("SWEET ADRENO: DCVS restore index 1 errno=%d measured=%u kHz\n",
+		    back, sweet_gpu_measure_khz(core));
+	}
+}
+
+static int
+sweet_gpu_cp_start(vm_offset_t gmu, vm_offset_t smmu)
+{
+ DTEntry node;
+ if (SecureDTLookupEntry(NULL, "/sweet-adreno", &node) != kSuccess) return ENOENT;
+ const unsigned char *sqe = NULL, *mdt = NULL, *code = NULL;
+ unsigned sqe_size = 0, mdt_size = 0, code_size = 0;
+ int error = sweet_gpu_blob(node, "sqe-firmware", "sqe-firmware-crc32", &sqe, &sqe_size);
+ if (!error) error = sweet_gpu_blob(node, "zap-metadata", "zap-metadata-crc32", &mdt, &mdt_size);
+ if (!error) error = sweet_gpu_blob(node, "zap-code", "zap-code-crc32", &code, &code_size);
+ const uint64_t *reserved_base = NULL;
+ const uint32_t *reserved_size = NULL;
+ unsigned length = 0;
+ if (!error && (SecureDTGetProperty(node, "zap-reserved-base", (const void **)&reserved_base,
+     &length) != kSuccess || length != 8 || *reserved_base != 0x93b15000ull)) error = EINVAL;
+ if (!error && (SecureDTGetProperty(node, "zap-reserved-size", (const void **)&reserved_size,
+     &length) != kSuccess || length != 4 || *reserved_size != 0x2000)) error = EINVAL;
+ printf("SWEET ADRENO: CP firmware properties errno=%d SQE=%u MDT=%u ZAP=%u\n",
+     error, sqe_size, mdt_size, code_size);
+ if (error) return error;
+ static struct a618_dma_region memory, metadata;
+ error = sweet_adreno_cp_allocate(&memory);
+ printf("SWEET ADRENO: CP DMA errno=%d PA=%#llx bytes=%u\n", error,
+     memory.physical, memory.bytes);
+ if (error) return error;
+ error = a618_cp_stage(&memory, sqe, sqe_size, sweet_adreno_barrier, NULL);
+ if (error) {
+  printf("SWEET ADRENO: SQE CPU staging/readback errno=%d\n", error);
+  return error;
+ }
+ /* Read the wired allocation through an independent physical IO mapping.
+  * Retain it with the wired storage for the boot lifetime. */
+ vm_offset_t physical_image = ml_io_map(memory.physical + A618_CP_SQE_OFFSET, 0x8000);
+ if (!physical_image) return ENOMEM;
+ volatile uint32_t *staged = (volatile uint32_t *)(memory.cpu + A618_CP_SQE_OFFSET);
+ unsigned verified = 0;
+ for (; verified < (sqe_size - 4) / 4; ++verified) {
+  if (sweet_adreno_read((void *)physical_image, verified * 4) != staged[verified]) {
+   error = EIO; break;
+  }
+ }
+ printf("SWEET ADRENO: SQE physical readback errno=%d words=%u first=%#x,%#x,%#x,%#x\n",
+     error, verified, sweet_adreno_read((void *)physical_image, 0),
+     sweet_adreno_read((void *)physical_image, 4), sweet_adreno_read((void *)physical_image, 8),
+     sweet_adreno_read((void *)physical_image, 12));
+ if (error) return error;
+ const struct a618_smmu_io smmu_io = {
+  {(void *)smmu, sweet_adreno_read, sweet_adreno_write, sweet_adreno_delay},
+  sweet_adreno_read64, sweet_adreno_write64, sweet_adreno_barrier};
+ struct a618_smmu_result map;
+ bzero(&map, sizeof(map));
+ extern int sweet_native_adreno_prepare_vm(const struct a618_smmu_io *,
+     const struct a618_dma_region *, struct a618_smmu_result *);
+ error = sweet_native_adreno_prepare_vm(&smmu_io, &memory, &map);
+ printf("SWEET ADRENO: CP SMMU errno=%d CB=%u slot=%u pages=%u offset=%#x value=%#x PAR=%#llx FSR=%#x\n",
+     error, map.context, map.slot, map.translated, map.offset, map.value, map.par, map.fault);
+ if (error) return error;
+ vm_offset_t core = ml_io_map(0x05000000, 0x40000);
+ if (!core) return ENOMEM;
+ const struct a618_io gpu_io = {(void *)core,
+     sweet_adreno_read, sweet_adreno_write, sweet_adreno_delay};
+ const struct a618_io gmu_io = {(void *)gmu,
+     sweet_adreno_read, sweet_adreno_write, sweet_adreno_delay};
+ error = sweet_adreno_pas_allocate(&metadata);
+ if (error) return error;
+ vm_offset_t zap = ml_io_map(*reserved_base, *reserved_size);
+ if (!zap) return ENOMEM;
+ struct sweet_gpu_zap_request request = {
+  .reserved = (volatile uint32_t *)zap, .physical = *reserved_base,
+  .metadata = &metadata, .mdt = mdt, .code = code,
+  .mdt_bytes = mdt_size, .code_bytes = code_size,
+ };
+ struct a618_cp_result cp;
+ bzero(&cp, sizeof(cp));
+ error = a618_cp_start(&gpu_io, &gmu_io, &memory, sqe, sqe_size,
+     sweet_adreno_barrier, NULL, sweet_gpu_zap_prepare, &request, &cp);
+ printf("SWEET ADRENO: pre-SQE ZAP attempted=%u errno=%d phase=%u status=%lld response=%#llx\n",
+     cp.secure_prepare_attempted, cp.secure_prepare_error, request.result.phase,
+     request.result.status, request.result.response);
+ printf("SWEET ADRENO: CP initial TSB control=%#x base=%#llx size=%#x\n",
+     cp.initial_tsb_control, cp.initial_tsb_base, cp.initial_tsb_size);
+ printf("SWEET ADRENO: CP aperture errno=%d phase=%u status=%lld response=%#llx\n",
+     cp.aperture_error, cp.aperture_phase, cp.aperture_status, cp.aperture_response);
+ printf("SWEET ADRENO: SQE ME_INIT errno=%d phase=%u submitted=%u completed=%u RPTR=%#x WPTR=%#x status=%#x IRQ=%#x fault=%#x\n",
+     error, cp.phase, cp.submitted, cp.completed, cp.rptr, cp.wptr, cp.status,
+     cp.interrupt, cp.hw_fault);
+ printf("SWEET ADRENO: CP startup IRQ power=%#x before_auth=%#x after_auth=%#x bootstrap_us=%u CP2GMU=%#x ACTLR=%#x\n",
+     cp.irq_after_power, cp.irq_before_auth, cp.irq_after_auth, cp.bootstrap_wait_us,
+     sweet_adreno_read((void *)core, 0x2048), sweet_adreno_read((void *)smmu, 0x8004));
+ printf("SWEET ADRENO: CP startup initial SQECTL=%#x INSTR=%#x%08x RB_CNTL=%#x snapshots=%u first_fault=%s\n",
+     cp.initial_sqectl, cp.initial_instr_hi, cp.initial_instr_lo,
+     cp.initial_rb_cntl, cp.snapshots, cp.first_fault ? cp.first_fault : "none");
+ for (unsigned i = 0; i < cp.snapshots; ++i)
+  printf("SWEET ADRENO: CP SNAP[%s] IRQ=%#x SQECTL=%#x INSTR=%#x%08x CNTL=%#x CP2GMU=%#x\n",
+      cp.snapshot[i].tag, cp.snapshot[i].irq, cp.snapshot[i].sqectl,
+      cp.snapshot[i].instr_hi, cp.snapshot[i].instr_lo,
+      cp.snapshot[i].rb_cntl, cp.snapshot[i].cp2gmu);
+ printf("SWEET ADRENO: CP execution status local_irq=%#x sqe_started=%u\n", cp.cp_interrupt, cp.sqe_started);
+ printf("SWEET ADRENO: CP MMU CB0FSR=%#x CB1FSR=%#x\n",
+     sweet_adreno_read((void *)smmu, 0x8058), sweet_adreno_read((void *)smmu, 0x9058));
+ /* Snapshot the first hardware fault before any new translation probe or
+  * W1C operation. ATOS success does not prove the CP used the same VA. */
+ printf("SWEET ADRENO: CP fault FAR=%#llx FSYNR0=%#x FSYNR1=%#x SID=%#x TTBR0=%#llx TCR=%#x SCTLR=%#x\n",
+     sweet_adreno_read64((void *)smmu, 0x8060),
+     sweet_adreno_read((void *)smmu, 0x8068), sweet_adreno_read((void *)smmu, 0x806c),
+     sweet_adreno_read((void *)smmu, 0x1400),
+     sweet_adreno_read64((void *)smmu, 0x8020),
+     sweet_adreno_read((void *)smmu, 0x8030), sweet_adreno_read((void *)smmu, 0x8000));
+ printf("SWEET ADRENO: CP addresses SQE=%#llx RING=%#llx SHADOW=%#llx CNTL=%#x SQECTL=%#x\n",
+     ((uint64_t)sweet_adreno_read((void *)core, 0x20c4) << 32) | sweet_adreno_read((void *)core, 0x20c0),
+     ((uint64_t)sweet_adreno_read((void *)core, 0x2004) << 32) | sweet_adreno_read((void *)core, 0x2000),
+     ((uint64_t)sweet_adreno_read((void *)core, 0x2014) << 32) | sweet_adreno_read((void *)core, 0x2010),
+     sweet_adreno_read((void *)core, 0x2008), sweet_adreno_read((void *)core, 0x2020));
+ if (error && (cp.sqe_started || cp.first_fault)) {
+  /* Bounded failure-only indexed SQE state, same 0x33-word bank as A6xx
+   * Linux devcoredump. Each DATA read auto-increments the index. No resume
+   * follows a poisoned CP, so changing this diagnostic selector is harmless. */
+  uint32_t state[51];
+  sweet_adreno_write((void *)core, 0x2420, 0);
+  for (unsigned i = 0; i < 51; ++i)
+   state[i] = sweet_adreno_read((void *)core, 0x2424);
+  for (unsigned i = 0; i < 51; i += 3)
+   printf("SWEET ADRENO: SQE_STAT[%u]=%#x,%#x,%#x\n", i, state[i], state[i + 1], state[i + 2]);
+  printf("SWEET ADRENO: CP hardware RPTR=%#x STATUS1=%#x INTERRUPT=%#x\n",
+      sweet_adreno_read((void *)core, 0x2018), sweet_adreno_read((void *)core, 0x2094),
+      sweet_adreno_read((void *)core, 0x208c));
+  /* Halt the poisoned engine before the bounded instruction-cache capture.
+   * This does not reset it or attempt another submission. Never write a halt
+   * to an engine that did not start: 0106 tests whether that write itself
+   * launches a fetch from the current instruction base. */
+  if (cp.sqe_started) {
+   sweet_adreno_write((void *)core, 0x2020, 3);
+   uint32_t halt = sweet_adreno_read((void *)core, 0x2020);
+   printf("SWEET ADRENO: SQE failure halt=%#x ACTLR=%#x HOST_AP=%#x SQE_AP=%#x\n",
+       halt, sweet_adreno_read((void *)smmu, 0x8004),
+       sweet_adreno_read((void *)core, 0x2800), sweet_adreno_read((void *)core, 0x2804));
+   if (halt != 0xffffffffu && (halt & 3) == 3) {
+    static uint32_t cache[1024];
+    sweet_adreno_write((void *)core, 0x2440, 0);
+    for (unsigned i = 0; i < 1024; ++i)
+     cache[i] = sweet_adreno_read((void *)core, 0x2444);
+    for (unsigned i = 0; i < 1024; i += 8)
+     printf("SWEET ADRENO: SQE_CACHE[%u]=%#x,%#x,%#x,%#x,%#x,%#x,%#x,%#x\n",
+         i, cache[i], cache[i + 1], cache[i + 2], cache[i + 3],
+         cache[i + 4], cache[i + 5], cache[i + 6], cache[i + 7]);
+   }
+  } else {
+   printf("SWEET ADRENO: SQE halted=%#x; no pre-start halt write or cache capture\n",
+       sweet_adreno_read((void *)core, 0x2020));
+  }
+ }
+ if (error) return error;
+ error = a618_cp_leave_secure(&gpu_io, &gmu_io, &memory,
+     sweet_adreno_barrier, NULL, &cp);
+ printf("SWEET ADRENO: CP fence errno=%d phase=%u submitted=%u completed=%u RPTR=%#x WPTR=%#x IRQ=%#x fault=%#x fence=%#x value=%#x\n",
+     error, cp.phase, cp.submitted, cp.completed, cp.rptr, cp.wptr, cp.interrupt,
+     cp.hw_fault, cp.fence, cp.value);
+ printf("SWEET ADRENO: CP bootstrap complete errno=%d; iOS rendering ABI unavailable\n", error);
+ if (!error) {
+  sweet_gpu_raise_clock(core, gmu);
+  extern int sweet_native_adreno_adopt(const struct a618_dma_region *, uintptr_t, uintptr_t, uintptr_t, unsigned);
+  error = sweet_native_adreno_adopt(&memory, core, gmu, smmu, cp.fence);
+  printf("SWEET ADRENO: NativeAdreno A618 handoff errno=%d; no userspace rendering\n", error);
+ }
+ return error;
+}
