+/*
+ * Raw UIO offsets need byte precision: physio rounds them to logical sectors,
+ * and its B_PHYS address can belong to either user or kernel space. uiomove
+ * preserves the UIO address-space and scatter/gather contract instead.
+ */
+static int
+sweet_ufs_raw_io(struct uio *uio, bool write)
+{
+	uint64_t part_bytes = su.nblocks * UFS_BLOCK;
+	uint64_t start = (uint64_t)uio_offset(uio);
+	int error = 0;
+
+	if (write && !su.writable) {
