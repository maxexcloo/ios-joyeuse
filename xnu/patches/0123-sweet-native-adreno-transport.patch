@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: MIT
+ * Shared IOAcceleratorES base class.
+ *
+ * QuartzCore looks up IOServiceMatching("IOAcceleratorES") once per process.
+ * The framebuffer publishes an empty instance for software-only boots; the
+ * Adreno transport subclasses the same class and publishes the real device
+ * once GPU bring-up completes.  Keeping one meta-class definition avoids a
+ * duplicate ODR symbol when both translation units are linked.
+ */
+#ifndef _SWEET_IO_ACCELERATOR_H
+#define _SWEET_IO_ACCELERATOR_H
+
+#include <IOKit/IOService.h>
+
+class IOAcceleratorES : public IOService {
+	OSDeclareDefaultStructors(IOAcceleratorES);
+};
+
+#endif /* _SWEET_IO_ACCELERATOR_H */
diff --git a/iokit/Kernel/arm/SweetNativeAdreno.cpp b/iokit/Kernel/arm/SweetNativeAdreno.cpp
new file mode 100644
index 0000000..c229b89
--- /dev/null
+++ b/iokit/Kernel/arm/SweetNativeAdreno.cpp
@@ -0,0 +1,162 @@
+/* SPDX-License-Identifier: MIT
+ * Sweet/A618 adapter for the MIT UniXNU ring core. Kernel callers only.
+ * Keeps the proven 16K-host/4K-GPU mappings and existing CP owner alive.
+ * No IOKit accelerator or userspace PM4 interface is published here.
+ */
+#include <IOKit/IOLib.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+#include "../../../bsd/dev/sweet_adreno_cp.h"
+#include "unixnu/NativeAdrenoRing.h"
+
+extern "C" int sweet_native_adreno_connect_vm(NativeAdrenoRing *,IOLock *,const NativeAdrenoRingClock *,
+    uintptr_t,int (*)(void *),int (*)(void *,uint32_t,uint32_t *));
+static NativeAdrenoRing native_ring;
+static IOLock *native_lock;
+static struct {
+ struct a618_dma_region memory;
+ volatile unsigned char *core, *gmu, *smmu;
+ bool mounted;
+} board;
+static uint32_t reg_read(volatile unsigned char *base, unsigned offset)
+{
+ uint32_t value=*reinterpret_cast<volatile uint32_t *>(base+offset);
+ __asm__ volatile("dmb oshld" ::: "memory");
+ return value;
+}
+static int ensure_ahb_fence_open()
+{
+ if(!board.gmu)return 1;
+ /* GMU-relative byte offsets: CTRL 0x24c48, STATUS 0x24c4c.
+  * STATUS bit 0 set means fenced; only request open when needed. */
+ uint32_t status=reg_read(board.gmu,A618_GMU_AHB_FENCE_STATUS);
+ if(status==UINT32_MAX)return 1;
+ if(status&1) {
+  *reinterpret_cast<volatile uint32_t *>(board.gmu+0x24c48)=0;
+  __asm__ volatile("dsb oshst" ::: "memory");
+  (void)reg_read(board.gmu,0x24c48);
+ }
+ for(unsigned us=0;us<=1000;us+=10) {
+  status=reg_read(board.gmu,A618_GMU_AHB_FENCE_STATUS);
+  if(status==UINT32_MAX)return 1;
+  if(!(status&1))return 0;
+  if(us<1000)IODelay(10);
+ }
+ return 1;
+}
+static bool faulted()
+{
+ if(ensure_ahb_fence_open())return true;
+ const uint32_t irq=reg_read(board.core,0x208c), hw=reg_read(board.core,0x2084);
+ const uint32_t fsr=reg_read(board.smmu,0x8058), gmu=reg_read(board.gmu,0x14648);
+ const uint32_t global=reg_read(board.core,0x804);
+ const uint32_t errors=(1u<<1)|(1u<<7)|(1u<<9)|(1u<<23)|(1u<<24)|(1u<<25);
+ return global==UINT32_MAX || (global&errors) || irq==UINT32_MAX || (irq&0xf7u) || hw || fsr==UINT32_MAX ||
+     (fsr&0xc00001feu) || gmu==UINT32_MAX || (gmu&(1u<<23));
+}
+/* One-time evidence for the first lost GPU: every term faulted() tests, plus
+ * the SMMU fault address/syndrome and the CP read pointer. Read-only. */
+extern "C" void sweet_native_adreno_fault_report(const char *why)
+{
+ if(!board.core || !board.smmu || !board.gmu)return;
+ if(ensure_ahb_fence_open()) {IOLog("SWEET RENDER: GPU LOST (%s): GMU AHB fence failed to open\n",why);return;}
+ const uint32_t irq=reg_read(board.core,0x208c), hw=reg_read(board.core,0x2084);
+ const uint32_t fsr=reg_read(board.smmu,0x8058), gmu=reg_read(board.gmu,0x14648);
+ const uint32_t global=reg_read(board.core,0x804);
+ const uint64_t far=(uint64_t)reg_read(board.smmu,0x8060)|((uint64_t)reg_read(board.smmu,0x8064)<<32);
+ IOLog("SWEET RENDER: GPU LOST (%s): RBBM_INT=%#x CP_INT=%#x CP_HW_FAULT=%#x CB0_FSR=%#x FAR=%#llx FSYNR0=%#x FSYNR1=%#x CB1_FSR=%#x GMU_HOST_INFO=%#x CP_RPTR=%#x CP_STATUS1=%#x\n",
+   why,global,irq,hw,fsr,far,reg_read(board.smmu,0x8068),reg_read(board.smmu,0x806c),
+   reg_read(board.smmu,0x9058),gmu,reg_read(board.core,0x2018),reg_read(board.core,0x2094));
+}
+static int io_read(void *,uint32_t index,uint32_t *value)
+{
+ if(!value || index>=0x10000 || ensure_ahb_fence_open() || faulted())return 1;
+ *value=reg_read(board.core,index*4);
+ return *value==UINT32_MAX;
+}
+static int io_barrier(void *)
+{
+ __asm__ volatile("dsb sy" ::: "memory");
+ return faulted()?1:0;
+}
+static int io_write(void *,uint32_t index,uint32_t value)
+{
+ /* Adoption writes nothing; runtime submission may only commit WPTR. */
+ if(index!=0x807 || value>=8192 || ensure_ahb_fence_open() || faulted())return 1;
+ for(unsigned us=0;us<1000;us+=10) {
+  __asm__ volatile("dmb oshst" ::: "memory");
+  *reinterpret_cast<volatile uint32_t *>(board.core+index*4)=value;
+  __asm__ volatile("dsb sy" ::: "memory");
+  uint32_t status=reg_read(board.gmu,A618_GMU_AHB_FENCE_STATUS);
+  if(status==UINT32_MAX)return 1;
+  if(!(status&1))return faulted()?1:0;
+  IODelay(10);
+ }
+ return 1;
+}
+static int publish(void *,const volatile uint32_t *words,size_t bytes)
+{
+ if(reinterpret_cast<uintptr_t>(words)!=reinterpret_cast<uintptr_t>(board.memory.cpu+A618_CP_RING_OFFSET) ||
+    bytes!=0x8000)return 1;
+ return io_barrier(nullptr);
+}
+static int acquire(void *,volatile uint32_t *words,size_t bytes)
+{
+ const uintptr_t at=reinterpret_cast<uintptr_t>(words);
+ const uintptr_t start=reinterpret_cast<uintptr_t>(board.memory.cpu+A618_CP_FENCE_OFFSET);
+ if(at<start || bytes>0x4000 || at-start>0x4000-bytes)return 1;
+ return io_barrier(nullptr); /* original backing is cache-inhibited */
+}
+static uint64_t now_us(void *)
+{
+ uint64_t ns=0;
+ absolutetime_to_nanoseconds(mach_absolute_time(),&ns);
+ return ns/1000;
+}
+static int idle(void *) {IODelay(10);return 0;}
+extern "C" int sweet_native_adreno_adopt(const struct a618_dma_region *memory,
+    uintptr_t core,uintptr_t gmu,uintptr_t smmu,unsigned seed)
+{
+ if(board.mounted || native_lock || !memory || !memory->cpu || !memory->uncached ||
+    memory->bytes!=A618_CP_DMA_BYTES || !core || !gmu || !smmu)return EINVAL;
+ board.memory=*memory;
+ board.core=reinterpret_cast<volatile unsigned char *>(core);
+ board.gmu=reinterpret_cast<volatile unsigned char *>(gmu);
+ board.smmu=reinterpret_cast<volatile unsigned char *>(smmu);
+ native_lock=IOLockAlloc();
+ if(!native_lock)return ENOMEM;
+ const NativeAdrenoRingIo io={nullptr,io_write,io_read,io_barrier};
+ const NativeAdrenoRingCache cache={nullptr,publish,acquire};
+ IOReturn result=native_ring.adoptA6xx(&io,&cache,memory->cpu+A618_CP_RING_OFFSET,0x8000,A618_CP_RING_IOVA,
+     memory->cpu+A618_CP_FENCE_OFFSET,4,A618_CP_FENCE_IOVA,
+     reinterpret_cast<volatile uint32_t *>(memory->cpu+A618_CP_SHADOW_OFFSET),A618_CP_SHADOW_IOVA,seed);
+ const NativeAdrenoRingClock clock={nullptr,now_us,idle};
+ if(result==kIOReturnSuccess && sweet_native_adreno_connect_vm(&native_ring,native_lock,&clock,core,io_barrier,io_read))result=kIOReturnIOError;
+ board.mounted=result==kIOReturnSuccess;
+ IOLog("SWEET NATIVE ADRENO: A618 ring adopt status=%#x ready=%u; kernel-only, no renderer\n",result,board.mounted);
+ return board.mounted?0:EIO;
+}
+/* Private synchronous kernel submission. Caller owns immutable PM4 words;
+ * the ring copies them before WPTR. Never wire to an unchecked userclient.
+ * Timeout retains allocations and marks the adapter unusable; no retry. */
+extern "C" int sweet_native_adreno_submit(const uint32_t *words,unsigned count,unsigned *fence)
+{
+ if(!words || !count || count>4096 || !fence)return EINVAL;
+ *fence=0;
+ if(!board.mounted || !native_lock)return ENXIO;
+ IOLockLock(native_lock);
+ if(!board.mounted) {IOLockUnlock(native_lock);return ENXIO;}
+ uint32_t issued=0;
+ IOReturn result=native_ring.submit(words,count,&issued);
+ int error=result==kIOReturnSuccess?0:EIO;
+ if(!error) {
+  const NativeAdrenoRingClock clock={nullptr,now_us,idle};
+  const NativeAdrenoRingFence completed=native_ring.wait(issued,&clock,10000,nullptr);
+  if(completed!=NativeAdrenoRingFenceComplete)error=completed==NativeAdrenoRingFenceTimeout?ETIMEDOUT:EIO;
+ }
+ if(error)board.mounted=false;
+ else *fence=issued;
+ IOLockUnlock(native_lock);
+ return error;
+}
diff --git a/iokit/Kernel/arm/SweetNativeAdrenoClient.cpp b/iokit/Kernel/arm/SweetNativeAdrenoClient.cpp
new file mode 100644
index 0000000..d8e7c78
--- /dev/null
+++ b/iokit/Kernel/arm/SweetNativeAdrenoClient.cpp
@@ -0,0 +1,596 @@
+/* SPDX-License-Identifier: MIT
+ * IOKit transport for the real NativeAdreno ABI. One compositor connection,
+ * one resource gate, synchronous quiescence before VM edits/cache publication.
+ */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <pexpert/pexpert.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <kern/task.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <sys/proc.h>
+#include <sys/signal.h>
+#include "unixnu/NativeAdrenoUserClient.h"
+#include "SweetIOAccelerator.h"
+extern "C" void proc_selfname(char *,int);
+extern "C" volatile uint32_t native_adreno_wc_enabled;
+extern "C" volatile uint32_t native_adreno_wc_audit[6];
+extern "C" volatile uint32_t native_adreno_wc_distrusted;
+extern "C" uint64_t native_adreno_publish_stats[3];
+extern "C" volatile uint32_t native_adreno_import_sync;
+extern "C" volatile uint64_t native_adreno_import_sync_below;
+extern "C" void sweet_native_adreno_fault_report(const char *why);
+extern "C" volatile uint32_t native_adreno_pool_stats[8];
+namespace {
+struct Backend {
+ NativeAdrenoVm *vm=nullptr;
+ NativeAdrenoSubmit *submit=nullptr;
+ NativeAdrenoRing *ring=nullptr;
+ IOLock *lock=nullptr;
+ NativeAdrenoRingClock clock{};
+ NativeAdrenoTimer timer;
+ NativeAdrenoStatus status;
+ NativeAdrenoAbiDeviceInfo info{};
+ int (*health)(void *)=nullptr;
+ bool published=false,opened=false,lost=false,cpu_present=false;
+ bool pipeline=true;   // sweetpipeline=0 restores a full drain before every submit/map
+ bool present_locked=false;   // sweetpresentlock=1: present holds the lock across drain and copy
+ bool present_swap_fence=false;   // sweetpresentfence=1: wait for the SwapEnd-time fence
+ bool wait_unlocked=true;   // sweetwaitlock=1: WaitFence spins with the lock held, as before 0144
+ /* Slot 0 is backboardd's original window. Extra slots are separate 256 MiB
+  * windows of the same 2 GiB arena above it, each with its own queue range,
+  * so one client's IOVAs can never collide with another's. */
+ bool slot_open[4]={false,false,false,false};
+ unsigned extra_slots=3;
+} backend;
+/* 0x70000000.. holds the kernel's CP firmware/ring/fence (A618_CP_IOVA): the
+ * 0129 windows overlapped it and every extra BoMap was refused as Busy. */
+enum : uint64_t {ExtraWindowStart=0x80000000,ExtraWindowBytes=0x10000000};
+/* Processes that receive a Metal device besides backboardd. AegirPoster (the
+ * configured iOS 16 wallpaper) aborts without one; sweetm2extra=0 disables. */
+bool extra_client(const char *name)
+{
+ static const char *const names[]={"AegirPoster"};
+ for(const char *n:names)if(!strcmp(name,n))return true;
+ return false;
+}
+// Release/acquire publishes the completed backend to the framebuffer workloop.
+static bool presentation_ready=false;
+char last_submitter[32];   // process of the newest successful submit (diagnostics)
+bool healthy()
+{
+ if(backend.lost)return false;
+ const bool fault=!backend.health || backend.health(nullptr);
+ if(fault || backend.vm->poisoned() || backend.submit->poisoned() || backend.ring->poisoned()) {
+  backend.lost=true;backend.status.noteFault();
+  char why[96];
+  snprintf(why,sizeof why,"%s%s%s%s last_submit=%s fence=%u/%u",fault?"hw-fault ":"",
+    backend.vm->poisoned()?"vm ":"",backend.submit->poisoned()?"submit ":"",
+    backend.ring->poisoned()?"ring ":"",last_submitter,backend.ring->completedFence(),backend.ring->lastSubmitted());
+  sweet_native_adreno_fault_report(why);
+  return false;
+ }
+ return true;
+}
+IOReturn quiesce()
+{
+ if(!healthy())return kIOReturnIOError;
+ IOReturn result=backend.submit->waitAll(&backend.clock,1000000);
+ if(!result)result=backend.ring->drainA6xx(&backend.clock,1000000);
+ if(result) {
+  // 0130 hardware: the backend was lost here (no faulted() term) right after
+  // an AegirPoster instance was killed; say so with the CP state.
+  backend.lost=true;backend.status.noteFault();
+  char why[96];
+  snprintf(why,sizeof why,"quiesce %#x last_submit=%s fence=%u/%u",result,last_submitter,
+    backend.ring->completedFence(),backend.ring->lastSubmitted());
+  sweet_native_adreno_fault_report(why);
+ }
+ return result;
+}
+}
+/* The panel is CPU-copied, unlike a display engine that consumes a GPU fence.
+ * Hold the shared submission/VM gate across quiescence and the source copy so
+ * another submit cannot overwrite its source during the CPU read. This waits
+ * real CP fences; it never declares pending work complete. */
+/* 1 = lock held until present_end (sweetpresentlock=1: full drain, then the
+ * copy under the lock, as 0125-0131). 2 = gate passed without the lock: wait
+ * only for the newest fence submitted when presenting starts, with the lock
+ * taken just for each instantaneous check. CACHE_FLUSH_TS writes that fence
+ * after the frame's render output, and present() still does the physical
+ * cache acquire. 0127 hardware: holding the lock 15-22ms per present
+ * serialized CoreAnimation's submissions behind the copy. */
+/* Newest fence handed out (0 before publication); read without the lock:
+ * a monotonic counter, used only to pick a wait target. */
+extern "C" uint32_t sweet_native_adreno_last_fence(void)
+{
+ if(!__atomic_load_n(&presentation_ready,__ATOMIC_ACQUIRE) || !backend.ring)return 0;
+ return backend.ring->lastSubmitted();
+}
+/* swap_fence: sweet_native_adreno_last_fence() when SwapEnd recorded the frame.
+ * sweetpresentfence=1 waits for that one (the frame being shown) instead of
+ * the newest fence, which may belong to CoreAnimation's next frame. */
+extern "C" int sweet_native_adreno_cpu_present_begin(uint32_t swap_fence)
+{
+ if(!__atomic_load_n(&presentation_ready,__ATOMIC_ACQUIRE) || !backend.cpu_present)return 0;
+ const uint64_t began=backend.clock.now_us(backend.clock.cookie);
+ static unsigned presents=0;
+ if(backend.present_locked) {
+  IOLockLock(backend.lock);
+  const IOReturn result=quiesce();
+  if(++presents<=4 || presents%120==0)
+   IOLog("SWEET RENDER: CPU present gate %u wait_us=%llu result=%#x locked\n",presents,
+     backend.clock.now_us(backend.clock.cookie)-began,result);
+  if(result) {IOLockUnlock(backend.lock);return -1;}
+  return 1;
+ }
+ IOLockLock(backend.lock);
+ const bool ok=healthy();
+ const uint32_t newest=ok?backend.ring->lastSubmitted():0;
+ const uint32_t target=backend.present_swap_fence && swap_fence && swap_fence-newest>0x80000000u?swap_fence:newest;
+ IOLockUnlock(backend.lock);
+ IOReturn result=ok?kIOReturnSuccess:kIOReturnIOError;
+ while(ok && target) {
+  IOLockLock(backend.lock);
+  result=healthy()?backend.submit->observeFence(target,&backend.clock,0):kIOReturnIOError;
+  IOLockUnlock(backend.lock);
+  if(result!=kIOReturnTimeout)break;
+  if(backend.clock.now_us(backend.clock.cookie)-began>=1000000)break;
+  IODelay(50);
+ }
+ if(++presents<=4 || presents%120==0)
+  IOLog("SWEET RENDER: CPU present gate %u fence=%u wait_us=%llu result=%#x unlocked\n",presents,target,
+    backend.clock.now_us(backend.clock.cookie)-began,result);
+ return result?-1:2;
+}
+extern "C" void sweet_native_adreno_cpu_present_end(int state)
+{
+ if(state==1)IOLockUnlock(backend.lock);
+}
+/* Per-window GPU and lock telemetry (0144). Busy is sampled from the
+ * framebuffer's 120 Hz timer: the newest fence still incomplete. A sample
+ * that finds the lock taken is counted apart rather than guessed. */
+namespace {
+struct MethodStat {uint64_t calls,us;};
+MethodStat method_stats[NativeAdrenoMethodSubmitResources+1];
+uint64_t lock_wait_us,lock_wait_max_us,lock_takes,wait_polls;
+unsigned busy_samples,idle_samples,locked_samples;
+uint64_t window_began_us;
+/* 0171: which blocks of the GPU are busy while a fence is outstanding (RBBM_STATUS, a6xx.xml bit names). Read only then,
+ * so the core is awake; a statistical profile of the 10 s window, not a count of cycles. */
+unsigned rbbm_samples,rbbm_idle,rbbm_bits[24];
+volatile uint32_t *rbbm_status;
+const char *const rbbm_names[24]={"CXM","CPM","CP","DBGC","VBIF","TSE","RAS","RB","CCU","A2D","LRZ","DCOM","DCALL","VSD","TESS",
+ "VFD","VPC","UCHE","SP","TPL1","VSC","HLSQ","IGNCP","IGN"};
+}
+extern "C" vm_offset_t ml_io_map(vm_offset_t,vm_size_t);
+extern "C" void sweet_native_adreno_sample_busy(void)
+{
+ if(!__atomic_load_n(&presentation_ready,__ATOMIC_ACQUIRE) || !backend.ring)return;
+ if(!IOLockTryLock(backend.lock)) {++locked_samples;return;}
+ const uint32_t newest=healthy()?backend.ring->lastSubmitted():0;
+ const IOReturn state=newest?backend.submit->observeFence(newest,&backend.clock,0):kIOReturnSuccess;
+ if(state==kIOReturnTimeout)++busy_samples;else ++idle_samples;
+  if(state==kIOReturnTimeout) {
+  if(!rbbm_status) {const vm_offset_t core=ml_io_map(0x05000000,0x40000);if(core)rbbm_status=(volatile uint32_t *)(core+0x840);}
+  const uint32_t st=rbbm_status?*rbbm_status:0xffffffffu;
+  if(st!=0xffffffffu) {
+   ++rbbm_samples;
+   if(!(st&~1u))++rbbm_idle;
+   for(unsigned b=0;b<24;b++)if(st&(1u<<b))++rbbm_bits[b];
+  }
+ }
+ IOLockUnlock(backend.lock);
+}
+/* Called with the lock held after each method; prints once per 10 s. */
+static void method_window(void)
+{
+ const uint64_t now=backend.clock.now_us(backend.clock.cookie);
+ if(!window_began_us) {window_began_us=now;return;}
+ if(now-window_began_us<10000000)return;
+ static const char *const names[]={"0","query","alloc","map","free","submit","wait","ts","status","setmeta","getmeta","mkq","rmq","cpumap","cpuunmap","devinfo","import","submit-res"};
+ char line[320];size_t at=0;
+ for(unsigned i=1;i<=NativeAdrenoMethodSubmitResources && at<sizeof line;i++) {
+  if(!method_stats[i].calls)continue;
+  at+=snprintf(line+at,sizeof line-at," %s=%llu/%llu",i<sizeof names/sizeof names[0]?names[i]:"?",
+    method_stats[i].calls,method_stats[i].us/method_stats[i].calls);
+ }
+ if(at>=sizeof line)at=sizeof line-1;
+ line[at]=0;
+ const unsigned sampled=busy_samples+idle_samples;
+ IOLog("SWEET RENDER: window_ms=%llu gpu_busy_pct=%u samples=%u locked=%u lock_avg_us=%llu lock_max_us=%llu wait_polls=%llu pool_mib=%u/%u peak pooled=%u fallback=%u calls/avg_us:%s\n",
+   (now-window_began_us)/1000,sampled?busy_samples*100/sampled:0,sampled,locked_samples,
+   lock_takes?lock_wait_us/lock_takes:0,lock_wait_max_us,wait_polls,native_adreno_pool_stats[3],native_adreno_pool_stats[4],
+   native_adreno_pool_stats[1],native_adreno_pool_stats[2],line);
+ if(rbbm_samples) {
+  char blocks[400];size_t n=0;
+  for(unsigned b=0;b<24 && n<sizeof blocks-16;b++)if(rbbm_bits[b]*100/rbbm_samples>=3)
+   n+=snprintf(blocks+n,sizeof blocks-n," %s=%u",rbbm_names[b],rbbm_bits[b]*100/rbbm_samples);
+  blocks[n]=0;
+  IOLog("SWEET RENDER: rbbm samples=%u (fence outstanding) idle=%u%% busy blocks%%:%s\n",rbbm_samples,rbbm_idle*100/rbbm_samples,blocks);
+ }
+ rbbm_samples=rbbm_idle=0;memset(rbbm_bits,0,sizeof rbbm_bits);
+ memset(method_stats,0,sizeof method_stats);
+ lock_wait_us=lock_wait_max_us=lock_takes=wait_polls=0;busy_samples=idle_samples=locked_samples=0;
+ window_began_us=now;
+}
+static void lock_timed(void)
+{
+ const uint64_t asked=backend.clock.now_us(backend.clock.cookie);
+ IOLockLock(backend.lock);
+ const uint64_t waited=backend.clock.now_us(backend.clock.cookie)-asked;
+ lock_wait_us+=waited;++lock_takes;if(waited>lock_wait_max_us)lock_wait_max_us=waited;
+}
+class AGXDeviceUserClient : public IOUserClient {
+ OSDeclareDefaultStructors(AGXDeviceUserClient)
+ NativeAdrenoUserClient *core_=nullptr;
+ task_t task_=TASK_NULL;
+ bool mounted_=false,closed_=false;
+ unsigned slot_=0;
+ NativeAdrenoAbiDeviceInfo info_{};   // this client's window; outlives core_
+ unsigned trace_calls_=0,trace_errors_=0;
+public:
+ bool mount(task_t task,void *securityID,UInt32 type,OSDictionary *properties,unsigned slot);
+ IOReturn externalMethod(uint32_t selector,IOExternalMethodArguments *arguments,
+     IOExternalMethodDispatch *dispatch,OSObject *target,void *reference) APPLE_KEXT_OVERRIDE;
+ IOReturn clientMemoryForType(UInt32 type,IOOptionBits *options,IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE;
+ IOReturn clientClose() APPLE_KEXT_OVERRIDE;
+ void free() APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(AGXDeviceUserClient,IOUserClient)
+/* Userland discovery matches this class, then loads the actual Metal bundle.
+ * The service is published only after VM, CP, render profile and transport are
+ * connected; unsupported Apple IOAccelerator command types stay unsupported. */
+class AGXAccelerator : public IOAcceleratorES {
+ OSDeclareDefaultStructors(AGXAccelerator)
+public:
