+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/* Fixed, compositor-only GLES bootstrap + QuartzCore timer env for Metal UI. */
+static int
+sweet_gles_exec_env(struct image_params *imgp, int ptr_size)
+{
+    const char *path=imgp->ip_strings+strlen("executable_path="), *base=path;
+    for (const char *c=path; *c; ++c) if (*c=='/') base=c+1;
+    int mtl=0;
+    if (PE_parse_boot_argn("sweetmtl", &mtl, sizeof(mtl)) && mtl==2) {
+        if (!strcmp(base,"SpringBoard") || !strcmp(base,"backboardd") || !strcmp(base,"PosterBoard")) {
+            if (imgp->ip_argspace<ptr_size) return E2BIG;
+            static const char ca_env[]="CA_FORCE_TIMER=1";
+            int ca_err=exec_add_user_string(imgp,CAST_USER_ADDR_T(ca_env),UIO_SYSSPACE,TRUE);
+            if (ca_err) return ca_err;
+            if (imgp->ip_argspace<ptr_size) return E2BIG;
+            imgp->ip_argspace-=ptr_size;
+            imgp->ip_envc++;
+            printf("SWEET UI: %s will run with CA_FORCE_TIMER=1\n", base);
+        }
+    }
+    int enabled=0;
+    if (!PE_parse_boot_argn("sweetgles", &enabled, sizeof(enabled)) || enabled!=1) return 0;
+    if (strcmp(base,"backboardd")) return 0;
+    if (imgp->ip_argspace<ptr_size) return E2BIG;
+    static const char env[]="DYLD_INSERT_LIBRARIES=/usr/lib/sweetgl.dylib";
+    int error=exec_add_user_string(imgp,CAST_USER_ADDR_T(env),UIO_SYSSPACE,TRUE);
+    if (error) return error;
+    if (imgp->ip_argspace<ptr_size) return E2BIG;
+    imgp->ip_argspace-=ptr_size;
+    imgp->ip_envc++;
+    printf("SWEET GLES: backboardd will load /usr/lib/sweetgl.dylib\n");
+    return 0;
+}
+#endif
+
