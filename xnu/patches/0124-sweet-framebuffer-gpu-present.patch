+/* Advance on an absolute cadence. Skip missed slots instead of queuing bursts. */
+void
+AppleCLCD::rearmVsync(void)
+{
+	uint64_t now = mach_absolute_time();
+	fNextVsync += fVsyncPeriod;
+	if (fNextVsync <= now) {
+		uint64_t skipped = (now - fNextVsync) / fVsyncPeriod + 1;
+		fNextVsync += skipped * fVsyncPeriod;
+		fStatsMissed += skipped;
+	}
+	uint64_t elapsed;
+	absolutetime_to_nanoseconds(now - fStatsStart, &elapsed);
+	if (elapsed >= 10ULL * NSEC_PER_SEC) {
+		const uint64_t presents = __atomic_exchange_n(&fStatsPresents, 0, __ATOMIC_RELAXED);
+		const uint64_t present_us = __atomic_exchange_n(&fStatsPresentUs, 0, __ATOMIC_RELAXED);
+		const uint64_t present_max = __atomic_exchange_n(&fStatsPresentMaxUs, 0, __ATOMIC_RELAXED);
+		const uint64_t coalesced = __atomic_exchange_n(&fStatsCoalesced, 0, __ATOMIC_RELAXED);
+		const uint64_t gate_us = __atomic_exchange_n(&fStatsGateUs, 0, __ATOMIC_RELAXED);
+		const uint64_t acquire_us = __atomic_exchange_n(&fStatsAcquireUs, 0, __ATOMIC_RELAXED);
+		const uint64_t copy_us = __atomic_exchange_n(&fStatsCopyUs, 0, __ATOMIC_RELAXED);
+		const uint64_t swaps = __atomic_exchange_n(&fStatsSwaps, 0, __ATOMIC_RELAXED);
+		const uint64_t beam_us = __atomic_exchange_n(&fStatsBeamUs, 0, __ATOMIC_RELAXED);
+		const uint64_t beam_skips = __atomic_exchange_n(&fStatsBeamSkips, 0, __ATOMIC_RELAXED);
+		IOLog("SWEET FB: timing window_ms=%llu callbacks=%llu present_calls=%llu missed_deadlines=%llu target=%u Hz present_avg_us=%llu present_max_us=%llu coalesced=%llu swaps=%llu gate_avg_us=%llu acquire_avg_us=%llu copy_avg_us=%llu beam_avg_us=%llu beam_skips=%llu\n",
+		    elapsed / NSEC_PER_MSEC, fStatsCallbacks, presents,
+		    fStatsMissed, fPresentHz, presents ? present_us / presents : 0, present_max, coalesced, swaps,
+		    presents ? gate_us / presents : 0, presents ? acquire_us / presents : 0, presents ? copy_us / presents : 0,
+		    presents ? beam_us / presents : 0, beam_skips);
+		fStatsStart = now;
+		fStatsCallbacks = fStatsMissed = 0;
+	}
+	fVsync->wakeAtTime(fNextVsync);
+}
